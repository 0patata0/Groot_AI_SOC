+def _context_fields(value, max_bytes):
+    """Exact bounded JSON fields; an omitted field is never an empty value."""
+    def safe(v, depth=0):
+        if depth>3:return False
+        if v is None or type(v) is bool:return True
+        if type(v) is int:return -(2**63)<=v<2**63
+        if isinstance(v,str):return len(v)<=256
+        if isinstance(v,list):return len(v)<=16 and all(safe(x,depth+1) for x in v)
+        if isinstance(v,dict):return len(v)<=24 and all(isinstance(k,str) and len(k)<=64 and safe(x,depth+1) for k,x in v.items())
+        return False
+    result={};not_shown=[]
+    for key,item in value.items():
+        if not isinstance(key,str) or len(key)>64:continue
+        try:fits=safe(item) and len(json.dumps({**result,key:item},ensure_ascii=False,allow_nan=False).encode())<=max_bytes
+        except (TypeError,ValueError,UnicodeError):fits=False
+        if fits:result[key]=item
+        elif len(not_shown)<24:not_shown.append(key)
+    return result,not_shown
+
