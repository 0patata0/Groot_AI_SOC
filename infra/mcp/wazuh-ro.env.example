# /etc/mcp/wazuh-ro.env — 읽기전용 Wazuh MCP 서버용 환경. B에 mcp:mcp 0600 으로 배치. (이 파일은 예시; 실제 값은 B와 CREDENTIALS.local.md 에만)
# 래퍼가 B에서 실행되므로 localhost 사용 (컨테이너 포트가 0.0.0.0에 publish 됨). 원격 실행 시 10.10.10.10.
WAZUH_API_HOST=127.0.0.1
WAZUH_API_PORT=55000
WAZUH_API_USERNAME=mcp-ro          # Wazuh API 전용 사용자, role=readonly (③에서 생성; admin/wazuh-wui 사용 금지)
WAZUH_API_PASSWORD=CHANGE_ME       # API 정책: 8~64자, 대·소문자·숫자·기호
WAZUH_INDEXER_HOST=127.0.0.1
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USERNAME=mcp-ro      # 인덱서 읽기 계정 (internal_users + readall 계열 롤; ③에서 생성. admin 사용 금지)
WAZUH_INDEXER_PASSWORD=CHANGE_ME
WAZUH_VERIFY_SSL=false             # 자체서명 인증서. CA 신뢰 구성 시 true
RUST_LOG=info
