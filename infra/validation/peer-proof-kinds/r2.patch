+"""Cross-period evidence counterexamples, not an accuracy test."""
+import copy,hashlib,json,unittest
+import review_channel_policy as policy
+import review_channel_worker as worker
+
+def receipt(**updates):
+    result={'limit':17,'returned_count':17,'scan_capped':True,'requested_since_kst':'2026-11-14T08:10:00+09:00',
+        'requested_until_kst':'2026-11-14T08:55:00+09:00','applied_filters':{'program_name':'sshd'},
+        'indexed_window_total_count':None,'status':'running','alerts':[{'message':'private log'}]}
+    result.update(updates);raw=json.dumps(result,ensure_ascii=False)
+    return {'server':'security-events','name':'search_wazuh_alerts','arguments':{'limit':17,'program_name':'sshd'},
+            'result':raw,'result_sha256':hashlib.sha256(raw.encode()).hexdigest(),'is_error':False,'is_write':False}
+
+def source(call=None):
+    call=receipt() if call is None else call
+    packet=policy.peer_question('sshd 조회 범위와 판단을 검토해줘',{'final_response':'sshd 한도17의 표본17건입니다. 전체 건수·정상 여부는 미확인입니다.'},
+        {'calls':[call],'origin':'source_read_audit','reusable_evidence':False})
+    return worker.peer_source_answer(packet)
+
+def fresh():return {'name':'search_wazuh_alerts','server':'security-events','arguments':{'limit':40},
+                   'result':json.dumps({'limit':40,'returned_count':40,'scan_capped':True,'applied_filters':{}})}
+
+def select(catalog,path,role='source_query_scope',kind='agree'):
+    proofs=catalog['source_scopes'] if role=='source_query_scope' else catalog['evidence']
+    ref=next(p for p in proofs if p['path']==path)
+    return {'kind':kind,'text':'' if role=='source_query_scope' else '상대 답변 당시 조회 범위를 원래 영수증과 대조했습니다.','source_ref':'a0',
+            'evidence_ref':ref['id'],'missing_field':'','claim_scope':role}
+
+class ProofRoles(unittest.TestCase):
+    def test_historical_limit_and_new_limit_are_independently_addressable(self):
+        s=source();c=worker.peer_reference_catalog(s,[fresh()])
+        self.assertEqual(next(p['quote'] for p in c['source_scopes'] if p['path']=='result.limit'),'"limit": 17')
+        self.assertEqual(next(p['quote'] for p in c['evidence'] if p['path']=='result.limit'),'"limit": 40')
+        self.assertFalse({p['id'] for p in c['evidence']}&{p['id'] for p in c['source_scopes']})
+
+    def test_source_limit_can_verify_query_scope_while_capped_new_count_cannot(self):
+        s=source();calls=[fresh()];before=copy.deepcopy(calls);c=worker.peer_reference_catalog(s,calls)
+        claim=select(c,'result.limit');bound=worker.bind_peer_references({'claims':[claim]},c)
+        self.assertIn('상대 조회 조건(과거)',worker.validate_peer_claims(bound,s,calls))
+        self.assertEqual(calls,before);self.assertNotIn('call_index',bound['claims'][0])
+        for path in ['result.limit','result.returned_count']:
+            bad=select(c,path,role='observation')
+            with self.assertRaisesRegex(ValueError,'peer_query_scope_mismatch'):worker.bind_peer_references({'claims':[bad]},c)
+
+    def test_historical_metadata_cannot_be_claimed_as_a_new_observation(self):
+        c=worker.peer_reference_catalog(source(),[fresh()]);bad=select(c,'result.limit');bad['claim_scope']='observation'
+        with self.assertRaisesRegex(ValueError,'peer_proof_role_mismatch'):worker.bind_peer_references({'claims':[bad]},c)
+
+    def test_reviewer_metadata_cannot_be_relabelled_as_original_query_scope(self):
+        c=worker.peer_reference_catalog(source(),[fresh()]);bad=select(c,'result.limit',role='observation');bad['claim_scope']='source_query_scope'
+        with self.assertRaisesRegex(ValueError,'peer_proof_role_mismatch'):worker.bind_peer_references({'claims':[bad]},c)
+
+    def test_source_scope_is_not_general_runtime_state_or_private_log_proof(self):
+        c=worker.peer_reference_catalog(source(),[fresh()]);paths={p['path'] for p in c['source_scopes']}
+        self.assertNotIn('result.status',paths);self.assertFalse(any('alerts' in p for p in paths))
+        self.assertIn('result.applied_filters.program_name',paths)
+
+    def test_scope_tag_cannot_hide_an_unsupported_current_state_sentence(self):
+        s=source();c=worker.peer_reference_catalog(s,[fresh()]);bad=select(c,'result.limit');bad['text']='현재 서비스는 정상이며 공격은0건입니다.'
+        with self.assertRaisesRegex(ValueError,'peer_source_scope_text_forbidden'):
+            worker.bind_peer_references({'claims':[bad]},c)
+        valid=worker.bind_peer_references({'claims':[select(c,'result.limit')]},c)
+        forged=copy.deepcopy(valid);forged['claims'][0]['text']=bad['text']
+        with self.assertRaisesRegex(ValueError,'peer_source_scope_text_forbidden'):
+            worker.validate_peer_claims(forged,s,[fresh()])
+        text=worker.validate_peer_claims(valid,s,[fresh()]);self.assertNotIn(bad['text'],text)
+        self.assertIn('당시 조회값',text);self.assertIn('17',text)
