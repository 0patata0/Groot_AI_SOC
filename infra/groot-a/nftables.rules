#!/usr/sbin/nft -f
# capstone_Groot_A 호스트 방화벽/게이트웨이 (FW)
# 트래픽: EXT → DMZ 는 웹(80/443)만, MGMT는 EXT에서 차단.
# Response Tool이 조작할 'agent_block' 체인을 미리 만들어 둔다.
# 주의: 인터페이스명·대역은 실제 VM에 맞게 확정(TODO).

flush ruleset

define IF_EXT  = "ens160"    # TODO: EXT NIC
define IF_DMZ  = "ens192"    # TODO: DMZ NIC
define IF_MGMT = "ens224"    # TODO: MGMT NIC
define DMZ_NET  = 172.16.20.0/24
define MGMT_NET = 10.10.10.0/24

table inet filter {
    # Agent(Response Tool)가 drop 규칙을 넣는 전용 체인
    chain agent_block {
    }

    chain input {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        iif "lo" accept
        # 관리 접근(SSH 등)은 MGMT에서만
        iifname $IF_MGMT tcp dport 22 accept
        ip protocol icmp accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        jump agent_block
        ct state established,related accept
        # EXT → DMZ: 웹만 허용 (WAF/IPS 검사 경로)
        iifname $IF_EXT oifname $IF_DMZ tcp dport { 80, 443 } accept
        # DMZ → MGMT: Wazuh Agent 통신(1514/1515) 허용
        iifname $IF_DMZ oifname $IF_MGMT tcp dport { 1514, 1515 } accept
        # EXT → MGMT 직접 접근 차단(정책 drop으로 이미 막힘, 명시)
        iifname $IF_EXT oifname $IF_MGMT drop
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}

# NAT: DMZ의 인터넷 아웃바운드가 필요하면 호스트 실제망으로 masquerade (TODO: 필요 시 활성화)
# table ip nat {
#     chain postrouting {
#         type nat hook postrouting priority 100;
#         oifname "<REAL_NET_IF>" masquerade
#     }
# }

# inline IPS(NFQUEUE)로 전환할 때: forward에서 웹 트래픽을 'queue num 0'로 보내 Suricata 검사.
# 초기에는 Suricata를 IDS(passive)로 두고 위 규칙만 사용.
