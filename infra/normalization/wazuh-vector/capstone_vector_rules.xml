</group>

<!-- Native journal health messages from the fixed storage wrapper. No synthetic
     operational messages are emitted by the test suite. -->
<group name="capstone_vector_health,">
  <rule id="100240" level="0">
    <program_name type="pcre2">^capstone-vector-storage$</program_name>
    <location type="pcre2">^\(groot-sec\) any->journald$</location>
    <description>Capstone Vector storage maintenance status</description>
    <options>no_log</options>
  </rule>
  <rule id="100241" level="3" ignore="900">
    <if_sid>100240</if_sid>
    <match type="pcre2">^status=disk_space_low$</match>
    <description>Vector storage free space is low</description>
    <options>no_email_alert</options>
  </rule>
  <rule id="100242" level="5" ignore="900">
    <if_sid>100240</if_sid>
    <match type="pcre2">^status=disk_space_critical$</match>
