[Unit]
Description=Read-only root attestation of isolated sudo lab
After=user@1991.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/capstone-offline-labs/nonweb/sudo/publish.py
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
TimeoutStartSec=100
MemoryMax=128M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/capstone-offline-labs /var/lib/capstone-sudo-runtime/.local/state/capstone-sudo-lab
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
