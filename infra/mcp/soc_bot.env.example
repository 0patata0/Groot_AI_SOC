# /etc/socbot/soc_bot.env — SOC 챗봇(serve) 설정. B 에 root:socbot 0640. 비밀은 repo 에 두지 않음.
# 읽기 자격(mcp-ro)은 /etc/mcp/wazuh-ro.env(WAZUH_*)를 systemd EnvironmentFile 로 함께 로드해 재사용.
MM_WEBHOOK=http://10.200.10.10:8065/hooks/<incoming-webhook-id>   # report 게시용
SLASH_TOKEN=<mattermost /soc 슬래시 명령 토큰>                     # serve 요청 검증
LISTEN=0.0.0.0:8090                                              # 봇 리슨(MM 컨테이너가 172.19.0.1 로 도달)
# 슬래시 명령 URL(MM 측)= http://172.19.0.1:8090 (mm-net 게이트웨이). MM SSRF 예외(AllowedUntrustedInternalConnections)에 이 IP 필요.

# --- Tier 2 승인 브로커 / Hermes 모니터 (2026-09-28) ---
# BROKER_TOKEN=<A hitl.env 의 RESP_BROKER_TOKEN 과 동일>   # POST /approval, GET /decision|/pending|/nonce (X-Broker-Token)
# READ_TOKEN=<Hermes 모니터 스크립트 SOC_READ_TOKEN>        # GET /recent (X-Read-Token)
# APPROVERS=<MM user id,...>                               # 버튼 클릭 허용 사용자(빈값=누구나)
# MM_ACTION_URL=http://172.19.0.1:8090                     # MM 컨테이너→브로커 콜백(SSRF allowlist 에 있어야 함)
# APPROVAL_TTL=900

# --- 선택 기능: 앞으로 생성하는 미응답 만료 승인 카드 정리 ---
# 기본 비활성. 본문/버튼만 지우고 '만료된 승인 요청' 표시를 남긴다.
# 승인/거부/소비/결과·감사기록·댓글·기존 webhook 카드는 보존한다. 게시물 DELETE는 사용하지 않는다.
# SOC_APPROVAL_CARD_CLEANUP=1
# SOC_CARD_MM_URL=http://10.200.10.10:8065
# SOC_CARD_MM_TOKEN=<지정된 일반 봇 토큰; system_admin 금지>
# SOC_CARD_MM_BOT_ID=<위 토큰의 봇 사용자 ID>
# SOC_CARD_MM_CHANNEL_ID=<승인 요청 전용 채널 ID>
# SOC_CARD_CLEANUP_DB=/var/lib/socbot/approval-cards.sqlite3
# DB 부모는 socbot 소유 0700, DB는 0600. 관련 모듈 approval_card_cleanup.py를 함께 배포한다.
# 5초 주기, 만료 후 정상 응답 기준 약 10초 목표. API 실패는 제한 재시도하며 판단·승인은 복원하지 않는다.
