# /etc/resp/hitl.env — 응답 서버 알림 채널 설정. A에 root:resp 0640 으로 배치(비밀 포함 가능 → repo·CREDENTIALS 에 두지 않음).
# 채널 교체 = 이 파일에서 RESP_NOTIFY_BACKEND 와 엔드포인트만 바꾸고 응답 서버 재연결. 코드 변경 없음.
# run-response.sh 가 있으면 source 한다. 승인(HITL)은 MCP elicitation(런타임)로 별개 처리 — 이 파일은 알림/감사 푸시용.

# none | http | email | slack(이 망 불가)
RESP_NOTIFY_BACKEND=none

# --- http (권장, 온프레미스): Mattermost/Rocket.Chat incoming webhook 또는 사내 웹훅 ---
# RESP_NOTIFY_BACKEND=http
# RESP_NOTIFY_URL=http://10.200.10.x:8065/hooks/xxxxxxxx      # 내부망 주소
# RESP_NOTIFY_TOKEN=                                          # (선택) Bearer 토큰

# --- email: 이 망은 아웃바운드 587 열림 ---
# RESP_NOTIFY_BACKEND=email
# RESP_NOTIFY_SMTP=smtp.example.ac.kr:587
# RESP_NOTIFY_FROM=soc@example.ac.kr
# RESP_NOTIFY_TO=oncall@example.ac.kr
# RESP_NOTIFY_SMTP_USER=
# RESP_NOTIFY_SMTP_PASS=

# --- slack: 아웃바운드 443 차단이라 이 망에선 동작 안 함(형태만 유지) ---
# RESP_NOTIFY_BACKEND=slack

# 정책 상한(선택; 기본 120/10분)
# RESP_MAX_MINUTES=120
# RESP_DEFAULT_MINUTES=10

# --- Tier 2 승인 브로커(B soc_bot, 2026-09-28): 차단(block_ip)은 Mattermost [승인][거부] 후에만 실행. 미설정이면 정책상 즉시 실행(구 동작) ---
# RESP_BROKER_URL=http://10.200.10.10:8090
# RESP_BROKER_TOKEN=<B /etc/socbot/soc_bot.env 의 BROKER_TOKEN 과 동일>
# RESP_APPROVAL_TIMEOUT=600      # 초. Hermes 의 mcp_servers.resp.timeout(720) 보다 작게
# RESP_APPROVAL_POLL=5
