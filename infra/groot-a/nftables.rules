#!/usr/sbin/nft -f
# capstone_Groot_A — NAT 게이트웨이 (Phase 1, 적용 중)
# 배포 경로: /etc/nftables.d/capstone-gw.nft  (capstone-nat.service → capstone-nat.sh 가 로드)
#
# ⚠️ 'flush ruleset' 절대 금지:
#    Docker가 같은 커널 netfilter 에 자체 iptables-nft 규칙(ip nat / ip filter, DOCKER-USER 등)을
#    관리한다. flush 하면 컨테이너 네트워킹이 깨진다. 이 파일은 '독립 테이블'만 추가한다.
# ⚠️ forward 허용은 이 파일이 아니라 DOCKER-USER 체인에서 처리한다:
#    Docker 가 FORWARD 정책을 DROP 으로 두고 DOCKER-USER 를 가장 먼저 점프하므로,
#    내부망→외부 통과 허용은 capstone-nat.sh 가 DOCKER-USER 에 ACCEPT 로 넣는다.

table ip capstone_gw {
    # 내부망(10.200.10.0/24) → 임시 외부(ens192) 아웃바운드 소스 NAT
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip saddr 10.200.10.0/24 oifname "ens192" masquerade
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# Phase 2 (미적용, 로드맵) : A 를 인라인 보안 어플라이언스(FW→IPS→WAF)로 확장할 때의 설계 초안.
# ⚠️ 아래를 그대로 적용하지 말 것 — 'flush ruleset' 및 input policy drop 은 Docker/SSH 를 끊는다.
#   - input : 관리 SSH 는 지정 대역에서만 허용, 그 외 drop (현재 SSH 는 ens192 192.168.16 경유이므로
#             해당 대역을 반드시 허용해야 함)
#   - forward : EXT→DMZ 웹(80/443)만 허용, agent_block 체인(Response Tool 이 drop 삽입), conntrack
#   - inline IPS : forward 웹 트래픽을 'queue num 0' 으로 Suricata(NFQUEUE) 검사
#   - WAF : ModSecurity 리버스 프록시 경유
#   상세 설계는 PLAN.md / infra/README.md 참조.
# ─────────────────────────────────────────────────────────────────────────────
