[Unit]
Description=Capstone bounded raw log rotation (%i)
After=docker.service capstone-vector.service wazuh-agent.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/capstone-raw-operations run %i
TimeoutStartSec=260s
TimeoutStopSec=10s
KillMode=control-group
# Deferred work is reported by structured stdout; it is not completed rotation.
SuccessExitStatus=2 75
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/capstone-raw-operations
ReadWritePaths=/var/lib/capstone-automation/ansible/vector.lock
ReadWritePaths=/home/groot_a/capstone/secstack/logs/suricata
ReadWritePaths=/home/groot_a/capstone/secstack/logs/modsec
StandardOutput=journal
StandardError=journal
