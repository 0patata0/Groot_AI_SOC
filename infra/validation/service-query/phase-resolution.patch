esponse_unavailable\') from exc\n                response.choices[0].message.content=\'\xec\x9d\xbd\xea\xb8\xb0 \xeb\x8f\x84\xea\xb5\xac \xec\x84\xa0\xed\x83\x9d\xec\x9d\xb4 \xea\xb2\x80\xec\xa6\x9d\xec\x9d\x84 \xed\x86\xb5\xea\xb3\xbc\xed\x95\x98\xec\xa7\x80 \xeb\xaa\xbb\xed\x96\x88\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4. \xec\x8b\xa4\xec\xa0\x9c \xec\xa1\xb0\xed\x9a\x8c\xeb\x8a\x94 \xec\x88\x98\xed\x96\x89\xed\x95\x98\xec\xa7\x80 \xec\x95\x8a\xec\x95\x98\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4.\\nMANAGEMENT_STATUS: needs_review\'\n                response.choices[0].message.tool_calls=None;response.choices[0].finish_reason=\'stop\'\n                return replace(verdict,response=response)\n            return verdict\n        sys.stderr.write(\'management_read_selection \'+json.dumps({\'accepted\':True,\'selected_reads\':count,\n            \'provider_seconds\':round(time.monotonic()-started,6),\'native_dispatch\':count>0,\n            \'report_projection\':count==0 and (\'report_facts\' in selection or selection.get(\'incident_report\')) and not selection.get(\'repeated_read_rejected\') and getattr(agent,\'_capstone_more_evidence_turn\',None)!=selection[\'turn\'],\n            \'repeated_read_rejected\':bool(selection.get(\'repeated_read_rejected\')),\n            \'indexed_reads\':\'indexed_options\' in selection,\'compact_report\':\'compact_citations\' in selection or bool(selection.get(\'incident_report\')),\n            \'inference_profile\':selection.get(\'incident_inference_profile\'),\n            \'additional_inquiry\':bool(selection.get(\'additional_inquiry\')),\n            \'literal_report_repair\':bool(selection.get(\'literal_report_repair\')),\n            \'initial_selection_retry\':bool(selection.get(\'initial_selection_retry\')),\n                \'reasoning_effort\':request.get(\'reasoning_effort\'),\n            \'input_message_bytes\':len(json.dumps(request.get(\'messages\',[]),ensure_ascii=False).encode()),\n            \'usage\':(verdict.response.us