    <options>no_log</options>
  </rule>
  <rule id="100293" level="3" frequency="5" timeframe="60">
    <if_sid>100291</if_sid>
    <if_matched_sid>100291</if_matched_sid>
    <same_field>capstone_norm.sensor</same_field>
    <same_field>capstone_norm.correlation_key</same_field>
    <same_field>capstone_validation.run_id</same_field>
    <different_field>capstone_norm.correlation_dedupe_key</different_field>
    <description>CAPSTONE SYNTHETIC CANARY repeat; run=$(capstone_validation.run_id); not an attack</description>
    <options>no_email_alert</options>
    <options>no_full_log</options>
    <group>capstone_validation,</group>
  </rule>
  <rule id="100294" level="3" frequency="2" timeframe="60">
    <if_sid>100292</if_sid>
    <if_matched_sid>100291</if_matched_sid>
    <same_field>capstone_norm.sensor</same_field>
    <same_field>capstone_norm.correlation_key</same_field>
    <same_field>capstone_validation.run_id</same_field>
    <different_field>capstone_norm.correlation_dedupe_key</different_field>
    <description>CAPSTONE SYNTHETIC CANARY cross-source; run=$(capstone_validation.run_id); not an attack</description>
    <options>no_email_alert</options>
    <options>no_full_log</options>
    <group>capstone_validation,</group>
