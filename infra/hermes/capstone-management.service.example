[Unit]
Description=Deliver durable SOC cases to the Hermes LLM management session
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
# Root-owned 0600 file; RULE_BROKER_TOKEN and MM_WEBHOOK only.
EnvironmentFile=/etc/capstone-management/controller.env
ExecStart=/usr/bin/python3 -B /opt/capstone-management/soc_management_controller.py --once
TimeoutStartSec=290
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/capstone-management
# Host controller requires the existing Docker socket solely for the fixed
# MCP-only Hermes wrapper. The model never receives this socket or root token.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
