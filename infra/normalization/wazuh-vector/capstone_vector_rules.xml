    <field name="capstone_norm.schema_version" type="pcre2">^vector-1$</field>
    <field name="capstone_norm.pipeline" type="pcre2">^vector$</field>
    <field name="capstone_norm.source" type="pcre2">^(suricata|nftables)$</field>
    <location type="pcre2">^\(groot-sec\) any->/var/log/capstone-vector/canary/normalized\.jsonl$</location>
    <field name="capstone_validation.kind" type="pcre2">^correlation-e2e$</field>
    <field name="capstone_validation.run_id" type="pcre2">^[0-9a-f]{32}$</field>
    <field name="capstone_norm.sensor" type="pcre2">^capstone-canary$</field>
    <field name="capstone_norm.source_ip" type="pcre2">^192\.0\.2\.40$</field>
    <field name="capstone_norm.destination_ip" type="pcre2">^198\.51\.100\.20$</field>
    <field name="capstone_norm.destination_port" type="pcre2">^8443$</field>
    <field name="capstone_norm.protocol" type="pcre2">^tcp$</field>
    <field name="capstone_norm.correlation_eligible" type="pcre2">^true$</field>
    <field name="capstone_norm.correlation_time_class" type="pcre2">^fresh$</field>
    <field name="capstone_norm.correlation_key" type="pcre2">^[0-9a-f]{64}$</field>
    <field name="capstone_norm.correlation_dedupe_key" type="pcre2">^[0-9a-f]{64}$</field>
