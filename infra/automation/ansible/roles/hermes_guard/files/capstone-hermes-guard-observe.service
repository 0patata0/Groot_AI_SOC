[Unit]
Description=Forward only bounded Hermes language-guard verdict metadata to journal
After=docker.service

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/bin/bash -o pipefail -c '/usr/bin/tail -n 0 -F /opt/hermes-data/logs/gateway.log | /usr/bin/awk -f /opt/capstone-automation/hermes-guard/guard-metadata.awk'
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=null
SyslogIdentifier=capstone-hermes-guard

[Install]
WantedBy=multi-user.target
