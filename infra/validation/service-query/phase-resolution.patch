check the effective payload after native tool refresh and body overrides."""\n    if not isinstance(request, dict):\n        raise RuntimeError(\'management_request_shape_invalid\')\n    result = dict(request)\n    extra = result.get(\'extra_body\')\n    extra = dict(extra) if isinstance(extra, dict) else {}\n    if \'tools\' in result or \'tools\' in extra:\n        tools = permitted_tools(extra.pop(\'tools\', result.get(\'tools\')), mode)\n        result[\'tools\'] = tools\n        names = {tool[\'function\'][\'name\'] for tool in tools}\n        choice = extra.pop(\'tool_choice\', result.get(\'tool_choice\'))\n        if isinstance(choice, dict):\n            function = choice.get(\'function\')\n            name = function.get(\'name\') if isinstance(function, dict) else None\n            if name not in names:\n                raise RuntimeError(\'management_tool_choice_not_allowed\')\n        if choice is not None:\n            result[\'tool_choice\'] = choice\n    if extra or isinstance(result.get(\'extra_body\'), dict):\n        result[\'extra_body\'] = extra\n    return result\n\n\ndef compact_target_receipt(value):\n    """Audit metadata only; the model still receives the complete MCP result."""\n    try:\n        outer = json.loads(value)\n        if not isinstance(outer, dict) or outer.get(\'error\') or outer.get(\'isError\'):\n            return value\n        payload = json.loads(outer[\'result\'])\n        if (not isinstance(payload, dict) or payload.get(\'error\') or payload.get(\'isError\')\n                or not {\'target\', \'sha256\', \'runtime\'} <= payload.keys()):\n            return value\n        kept = {k: payload[k] for k in (\'target\', \'sha256\', \'runtime\', \'related_hashes\') if k in payload}\n        return json.dumps({\'result\': json.dumps(kept, ensure_ascii=False)}, ensure_ascii=False)\n    except (ValueError, KeyError, TypeError):\n        return value\n\n\ndef restore_registered_read_conditions(request, agent):\n    """Restore constraints lost by Native provider shaping, without adding tools.\n\n    Metadata is captured from the registry for this native turn. Existing API\n    property restrictions remain intact; restored conjunctions can only narrow.\n    """\n    bound=getattr(agent,\'_capstone_registered_read_conditions\',None)\n    if bound is None:return request\n    if (not isinstance(bound,tuple) or len(bound)!=2 or bound[0]!=getattr(agent,\'_current_turn_id\',None)\n            or not isinstance(bound[1],dict)):\n        raise RuntimeError(\'registered_read_condition_turn_mismatch\')\n    if not isinstance(request.get(\'tools\'),list):return request\n    result=copy.deepcopy(request)\n    for tool in result[\'tools\']:\n        f=tool.get(\'function\',{});name=f.get(\'name\');source=bound[1].get(name)\n        if source is None:continue\n        target=f.get(\'parameters\')\n        if not isinstance(target,dict) or not isinstance(source,dict):\n            raise RuntimeError(\'registered_read_condition_shape_invalid\')\n        for key in (\'allOf\',\'required\'):\n            added=source.get(key,[]);current=target.get(key,[])\n            if not isinstance(added,list) or not isinstance(current,list):\n                raise RuntimeError(\'registered_read_condition_shape_invalid\')\n            if added:target[key]=current+[copy.deepcopy(v) for v in added if v not in current]\n        dependencies=source.get(\'dependentRequired\',{})\n        if dependencies:\n            existing=target.get(\'dependentRequired\',{})\n            if not isinstance(existing,dict) or not isinstance(dependencies,dict):\n                raise RuntimeError(\'registered_read_condition_shape_invalid\')\n            merged=copy.deepcopy(existing)\n            for key,names in dependencies.items():\n                previous=merged.get(key,[])\n                if not isinstance(names,list) or not isinstance(previous,list):\n                    raise RuntimeError(\'registered_read_condition_shape_invalid\')\n                merged[key]=list(dict.fromkeys(previous+names))\n            target[\'dependentRequired\']=merged\n        if source.get(\'additionalProperties\') is False:target[\'additionalProperties\']=False\n    return result\n\n\ndef initial_event_filter_schema(name, schema, question, requested_at_kst=None):\n    """First-chat optional filters require explicit IDs or literal addresses.\n\n    This only narrows the initial model choice. Controller-required parameters\n    and subsequent evidence-driven searches retain their registered schemas.\n    A first read is never narrower than the question: a filter value must be\n    named in it (2026-11-13 22:22: an unasked program_name=\'systemd\' narrowed a\n    review read, and an invented firewall snapshot failed the whole answer).\n    """\n    if str(name).endswith(\'__get_firewall_rules\'):\n        # A first firewall read is a fresh live snapshot. Paging tokens exist\n        # only in a previous page\'s result, never in the question.\n        # The first page starts at offset 0 (same as the SDK\'s first-page rule).\n        result=copy.deepcopy(schema)\n        props,required=result.get(\'properties\',{}),result.get(\'required\',[])\n        if \'snapshot\' in props and \'snapshot\' not in required:props.pop(\'snapshot\')\n        if \'offset\' in props and \'offset\' not in required:props[\'offset\']={**props[\'offset\'],\'enum\':[0]}\n        return result\n    if name not in {\'mcp__security_events__\'+n for n in\n            (\'search_suricata_alerts\',\'search_modsecurity_alerts\',\'search_wazuh_alerts\',\'search_web_access\')}:\n        return schema\n    from ipaddress import ip_address\n    labels={\'wazuh_rule_id\':r\'(?:wazuh_rule_id|rule_id|rule|\xeb\xa3\xb0|\xea\xb7\x9c\xec\xb9\x99)\',\n            \'signature_id\':r\'(?:signature_id|sid|rule|\xeb\xa3\xb0|\xea\xb7\x9c\xec\xb9\x99)\',\n            \'rule_id\':r\'(?:rule_id|rule|\xeb\xa3\xb0|\xea\xb7\x9c\xec\xb9\x99)\',\n            \'agent_id\':r\'(?:agent[_ ]?id|\xec\x97\x90\xec\x9d\xb4\xec\xa0\x84\xed\x8a\xb8\\s*ID)\'}\n    result=copy.deepcopy(schema)\n    for key in (\'source_ip\',\'wazuh_rule_id\',\'signature_id\',\'rule_id\',\'agent_id\',\'program_name\'):\n        if key not in result.get(\'properties\',{}) or key in result.get(\'required\',[]):continue\n        if key==\'program_name\':\n            # Only an explicitly labelled program, or systemd for a named\n            # systemd/service-failure question (the documented use).\n            values=list(dict.fromkeys(re.findall(r\'(?i)(?:program_name|program|\xed\x94\x84\xeb\xa1\x9c\xea\xb7\xb8\xeb\x9e\xa8)\\s*[:=]?\\s*[`\\\'"]?\'\n                                                 r\'([A-Za-z0-9_][A-Za-z0-9_.@-]{0,63})\',question)))\n            if re.search(r\'systemd|\xec\x84\x9c\xeb\xb9\x84\xec\x8a\xa4\\s*(?:\xec\x8b\xa4\xed\x8c\xa8|\xec\x9e\xa5\xec\x95\xa0|\xec\xa4\x91\xeb\x8b\xa8|\xec\x98\xa4\xeb\xa5\x98)|failed\\s+units?\',question,re.I):values.append(\'systemd\')\n            values=list(dict.fromkeys(values))\n        elif key==\'source_ip\':\n            values=[]\n            for token in re.findall(r\'[0-9a-fA-F:.]+\',question):\n                try:\n                    value=str(ip_address(token))\n                    if value not in values:values.append(value)\n                except ValueError:pass\n            # An address mentioned as destination/network is not a source filter.\n            # Preserve its schema for the existing actor/reference resolver.\n            if values and (len(values)!=1 or re.search(r\'/[0-9]{1,3}\',question)\n                    or not re.search(r\'(?:source_ip|\xec\xb6\x9c\xeb\xb0\x9c\xec\xa7\x80)\\s*(?:IP)?\\s*[:=]?\\s*[`\\\'"]?\'+re.escape(values[0]),question,re.I)):\n                continue\n        else:\n            values=list(dict.fromkeys(re.findall(r\'(?i)(?<![A-Za-z_])\'+labels[key]+\n                r\'\\s*(?:ID|\xec\x95\x84\xec\x9d\xb4\xeb\x94\x94)?\\s*[:#=]?\\s*[`\\\'"]?([0-9]{1,10})(?![0-9])\',question)))\n        prop=result[\'properties\'][key]\n        if isinstance(prop.get(\'enum\'),list):values=[v for v in values if v in prop[\'enum\']]\n        if values:prop[\'enum\']=values\n        else:result[\'properties\'].pop(key)\n    # Resolve only an unqualified "today" request. More specific times keep\n    # the original choice; a controller-bound interval is never overwritten.\n    at=parse_instant(requested_at_kst)\n    if (at is not None and at.utcoffset()==timedelta(hours=9) and re.search(r\'\xec\x98\xa4\xeb\x8a\x98|\xea\xb8\x88\xec\x9d\xbc\',question)\n            and not re.search(r\'\xec\xb5\x9c\xea\xb7\xbc|\xec\xa7\x80\xeb\x82\x9c|\xec\x96\xb4\xec\xa0\x9c|\xeb\x82\xb4\xec\x9d\xbc|\xeb\xb6\x80\xed\x84\xb0|\xea\xb9\x8c\xec\xa7\x80|\xec\x9d\xb4\xed\x9b\x84|\xec\x9d\xb4\xec\xa0\x84|\xec\x82\xac\xec\x9d\xb4|[0-9]\\s*(?:\xec\x8b\x9c|\xeb\xb6\x84|\xec\x8b\x9c\xea\xb0\x84)|[0-9]:[0-9]\',question)\n            and not {\'since_kst\',\'until_kst\',\'lookback_minutes\'} & set(result.get(\'required\',[]))\n            and {\'since_kst\',\'until_kst\',\'lookback_minutes\'} <= set(result.get(\'properties\',{}))):\n        start=at.replace(hour=0,minute=0,second=0,microsecond=0)\n        if start<at:\n            for key,value in ((\'since_kst\',start.isoformat()),(\'until_kst\',at.isoformat())):\n                prop=result[\'properties\'][key]\n                if \'enum\' in prop or \'const\' in prop:break\n            else:\n                for key,value in ((\'since_kst\',start.isoformat()),(\'until_kst\',at.isoformat())):\n                    result[\'properties\'][key][\'enum\']=[value]\n                result[\'properties\'].pop(\'lookback_minutes\')\n                result[\'required\']=list(dict.fromkeys(result.get(\'required\',[])+[\'since_kst\',\'until_kst\']))\n                return result\n    # One explicit recent window ("\xec\xb5\x9c\xea\xb7\xbc 30\xeb\xb6\x84") ends at the query itself: pin its\n    # length and drop the absolute ends, so the model computes no time (a\n    # computed end 26 s ahead was refused, and "\xec\xb5\x9c\xea\xb7\xbc 30\xeb\xb6\x84" was read as 60\n    # minutes, 2026-11-13). Shared parser with the SDK; a controller-bound\n    # interval is never overwritten.\n    minutes=diagnostic_contract().relative_lookback_minutes(question)\n    lookback=result.get(\'properties\',{}).get(\'lookback_minutes\')\n    if (minutes and isinstance(lookback,dict)\n            and not {\'since_kst\',\'until_kst\',\'lookback_minutes\'} & set(result.get(\'required\',[]))\n            and \'const\' not in lookback and minutes in lookback.get(\'enum\',[minutes])\n            and lookback.get(\'minimum\',1)<=minutes<=lookback.get(\'maximum\',1440)):\n        for key in (\'since_kst\',\'until_kst\'):result[\'properties\'].pop(key,None)\n        result[\'properties\'][\'lookback_minutes\']={**lookback,\'enum\':[minutes]}\n        result[\'required\']=list(dict.fromkeys(result.get(\'required\',[])+[\'lookback_minutes\']))\n    return result\n\n\ndef native_initial_selection_retry(request, agent, state, *, pending):\n    """Restore only the current compact read lease, never conversation history."""\n    chat=chat_read_context();catalog={}\n    tools=request.get(\'tools\')\n    if not isinstance(tools,list) or not 1<=len(tools)<=64:\n        raise RuntimeError(\'management_initial_selection_catalog_changed\')\n    for tool in tools:\n        f=tool.get(\'function\',{}) if isinstance(tool,dict) else {}\n        name=f.get(\'name\');schema=f.get(\'parameters\')\n        if (not isinstance(tool,dict) or tool.get(\'type\')!=\'function\' or name in catalog or not allowed(name,\'verify\')\n                or name not in getattr(agent,\'valid_tool_names\',()) or not isinstance(schema,dict)):\n            raise RuntimeError(\'management_initial_selection_catalog_changed\')\n        catalog[name]=schema\n    if (pending is not True or os.environ.get(\'CAPSTONE_EVIDENCE_REPORT_COMPACT\',\'0\')!=\'1\'\n            or os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\')!=\'verify\'\n            or state.get(\'turn\')!=getattr(agent,\'_current_turn_id\',None)\n            or state.get(\'chat\')!=chat or catalog!=state.get(\'source_catalog\')\n            or getattr(agent,\'provider\',None)!=\'custom\'\n            or getattr(agent,\'api_mode\',\'chat_completions\')!=\'chat_completions\'\n            or str(getattr(agent,\'base_url\',\'\')).rstrip(\'/\')!=\'http://10.200.10.10:11435/v1\'\n            or not verified_runtime_model(agent,request.get(\'model\'))\n            or request.get(\'tool_choice\')!=\'required\' or getattr(agent,\'_interrupt_requested\',False)\n            or type(state.get(\'repairs\')) is not int\n            or not 1<=state[\'repairs\']<=chat_lookup_harness().CONTRACT.REPAIR_PASSES):\n        raise RuntimeError(\'management_initial_selection_lease_changed\')\n    result=copy.deepcopy(state[\'original_request\']);selection=copy.deepcopy(state[\'original_selection\'])\n    old=json.dumps(selection[\'schema\'],ensure_ascii=False,separators=(\',\',\':\'))\n    selection[\'nonce\']=uuid.uuid4().hex\n    selection[\'schema\'][\'properties\'][\'request_nonce\'][\'const\']=selection[\'nonce\']\n    last=result[\'messages\'][-1]\n    if last.get(\'role\')!=\'user\' or not isinstance(last.get(\'content\'),str) or last[\'content\'].count(old)!=1:\n        raise RuntimeError(\'management_initial_selection_prompt_changed\')\n    last[\'content\']=last[\'content\'].replace(old,json.dumps(selection[\'schema\'],ensure_ascii=False,separators=(\',\',\':\')),1)\n    result[\'messages\'].append({\'role\':\'user\',\'content\':json.dumps(\n        {\'selection_validation\':state[\'feedback\']},ensure_ascii=False,separators=(\',\',\':\'))})\n    result[\'response_format\'][\'json_schema\'][\'schema\']=copy.deepcopy(selection[\'schema\'])\n    selection[\'initial_selection_retry\']=True\n    selection[\'initial_selection_messages\']=copy.deepcopy(result[\'messages\'])\n    agent._capstone_management_selection=selection\n    state.update(request_pending=False,last_rejected=False)\n    return result\n\n\ndef native_initial_selection_continuation(agent, original, native, append_message, reanchor, completed, kw):\n    """One bounded Native continuation; no provider or MCP calls here."""\n    state=getattr(agent,\'_capstone_initial_selection\',None)\n    if not isinstance(state,dict) or not state.get(\'last_rejected\'):return None\n    turn=getattr(agent,\'_current_turn_id\',None)\n    if state.get(\'turn\')!=turn:return None\n    message=kw.get(\'assistant_message\');messages=kw.get(\'messages\');user=kw.get(\'user_message\')\n    counter=kw.get(\'codex_ack_continuations\');count=kw.get(\'api_call_count\')\n    maximum=getattr(agent,\'max_iterations\',None)\n    remaining=getattr(getattr(agent,\'iteration_budget\',None),\'remaining\',None)\n    if (os.environ.get(\'CAPSTONE_EVIDENCE_REPORT_COMPACT\',\'0\')!=\'1\'\n            or os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\')!=\'verify\'\n            or state.get(\'turn\')!=turn or state.get(\'chat\')!=chat_read_context()\n            or not state.get(\'repair_pending\') or completed or getattr(agent,\'_interrupt_requested\',False)\n            or kw.get(\'finish_reason\')!=\'stop\' or getattr(message,\'tool_calls\',None)\n            or kw.get(\'_pending_verification_response\') is not None\n            or not isinstance(turn,str) or not turn or not isinstance(user,str) or not isinstance(messages,list)\n            or type(counter) is not int or not 0<=counter<3 or counter!=state.get(\'continuations\')\n            or type(count) is not int or type(maximum) is not int or not 0<=count<maximum-1\n            or remaining is not None and (type(remaining) not in (int,float) or not remaining>=2)):\n        return original(agent,**kw)\n    idx=reanchor(messages,user)\n    if (type(idx) is not int or not 0<=idx<len(messages) or not isinstance(messages[idx],dict)\n            or messages[idx].get(\'role\')!=\'user\