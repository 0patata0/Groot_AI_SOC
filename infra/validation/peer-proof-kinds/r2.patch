+# Historical source query metadata is intentionally separate from independent
+# observations. These fields describe what a source read requested/returned;
+# they never become tool calls, live state, approval, or a reusable cache entry.
+PEER_SOURCE_SCOPE_KEYS = frozenset({'target','source','observed_at','observed_at_kst',
+    'checked_at','limit','lookback_minutes','window_mode','requested_since_kst',
