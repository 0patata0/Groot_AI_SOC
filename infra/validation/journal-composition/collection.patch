+        core.need(type(stamp) is int and stamp >= 0, 'journal_native_timestamp')
+        core.need(previous is None or stamp <= previous, 'journal_native_source_order')
+        previous = stamp
+        if stamp > until:
+            continue
+        if stamp < since:
+            break
+        yield stamp
+
