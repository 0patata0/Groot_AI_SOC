window(label,row)\n            observations=row.get(\'observations\',[])\n            observations=observations if isinstance(observations,list) else []\n            rows.append((source+\' \xea\xb2\xbd\xeb\xb3\xb4\',result,\n                         label+(\' \xec\x83\x81\xec\x84\xb8 \xed\x91\x9c\' if event_details else \' \xec\x9a\x94\xec\x95\xbd \xed\x91\x9c\')+\'; \xec\x8b\x9c\xea\xb0\x81 \xed\x99\x95\xec\x9d\xb8 \xea\xb4\x80\xec\xb8\xa1 \'+str(len(observations))+\'\xed\x96\x89; \xeb\xb0\x98\xed\x99\x98 \xed\x91\x9c\xeb\xb3\xb8 \xec\xa0\x84\xec\xb2\xb4\xec\x99\x80 \xeb\x8f\x99\xec\x9d\xbc\xed\x95\xa8\xec\x9d\x84 \xeb\x9c\xbb\xed\x95\x98\xec\xa7\x80 \xec\x95\x8a\xec\x9d\x8c\'))\n            rules=[]\n            for label,key in [(\'WAF \xeb\xa3\xb0 ID\' if source==\'WAF\' else \'Suricata SID\',\'sensor_rule_ids\'),(\'Wazuh \xea\xb7\x9c\xec\xb9\x99 ID\',\'wazuh_rule_ids\')]:\n                ids=[v for v in row.get(key,[]) if isinstance(v,str) and re.fullmatch(\'[0-9]{1,10}\',v)]\n                rules.extend((label,value) for value in ids)\n            label=windows[-1][0]\n            if not event_details:\n                event_details_omitted=event_details_omitted or bool(observations or rules or row.get(\'source_ips\') or row.get(\'returned_count\'))\n                for o in observations:\n                    if isinstance(o,dict):\n                        instant=parse_instant(o.get(\'timestamp_kst\'))\n                        if instant:summary_event_times.add(instant)\n                addresses={ip for ip in row.get(\'source_ips\',[]) if isinstance(ip,str)}\n                summary=[(\'\xec\xb6\x9c\xeb\xb0\x9c\xec\xa7\x80 IP\',str(len(addresses)),\'\xed\x91\x9c\xec\x8b\x9c\xec\x9a\xa9 \xea\xb7\xbc\xea\xb1\xb0\xec\x9d\x98 \xec\x84\x9c\xeb\xa1\x9c \xeb\x8b\xa4\xeb\xa5\xb8 \xec\xa3\xbc\xec\x86\x8c \xec\x88\x98; \xec\xa0\x84\xec\xb2\xb4\xc2\xb7\xec\x8b\xa4\xec\xa0\x9c \xed\x98\xb8\xec\x8a\xa4\xed\x8a\xb8 \xec\x88\x98 \xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\')]\n                for group in dict.fromkeys(group for group,value in rules):\n                    summary.append((group,str(len({value for name,value in rules if name==group})),\'\xed\x91\x9c\xec\x8b\x9c\xec\x9a\xa9 \xea\xb7\xbc\xea\xb1\xb0\xec\x9d\x98 \xec\x84\x9c\xeb\xa1\x9c \xeb\x8b\xa4\xeb\xa5\xb8 \xea\xb7\x9c\xec\xb9\x99 ID \xec\x88\x98; \xec\xa0\x84\xec\xb2\xb4 \xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\'))\n                append_table(label+\' \xc2\xb7 \xeb\xb0\x98\xed\x99\x98 \xed\x91\x9c\xeb\xb3\xb8 \xec\x9a\x94\xec\x95\xbd\',(\'\xec\xa7\x91\xea\xb3\x84 \xed\x95\xad\xeb\xaa\xa9\',\'\xea\xb0\x9c\xec\x88\x98\',\'\xeb\xb2\x94\xec\x9c\x84\'),summary)\n                continue\n            append_table(label+\' \xc2\xb7 \xea\xb0\x9c\xeb\xb3\x84 \xea\xb4\x80\xec\xb8\xa1\',(\'\xeb\xb2\x88\xed\x98\xb8\',\'\xeb\xb0\x9c\xec\x83\x9d \xec\x8b\x9c\xea\xb0\x81(KST)\',\'\xec\xb6\x9c\xeb\xb0\x9c\xec\xa7\x80 IP\',\'\xeb\xaa\xa9\xec\xa0\x81\xec\xa7\x80 IP\',\'\xec\x88\x98\xec\xa7\x91 \xec\x97\x90\xec\x9d\xb4\xec\xa0\x84\xed\x8a\xb8\'),\n                  [(str(i),stamp(o.get(\'timestamp_kst\')),o.get(\'source_ip\') or \'IP \xec\xa0\x95\xeb\xb3\xb4 \xec\x97\x86\xec\x9d\x8c\',\n                    o.get(\'destination_ip\') or \'IP \xec\xa0\x95\xeb\xb3\xb4 \xec\x97\x86\xec\x9d\x8c\',o.get(\'sensor_agent\') or \'\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\')\n                   for i,o in enumerate(observations,1) if isinstance(o,dict)])\n            append_table(label+\' \xc2\xb7 \xeb\xb0\x98\xed\x99\x98 \xed\x91\x9c\xeb\xb3\xb8\xec\x9d\x98 \xea\xb7\x9c\xec\xb9\x99\',(\'\xea\xb7\x9c\xec\xb9\x99 \xea\xb5\xac\xeb\xb6\x84\',\'ID\'),rules)\n            # Aggregate addresses cannot be paired with a timestamp or rule by\n            # position. Show only those absent from the per-observation table.\n            linked={o.get(\'source_ip\') for o in observations if isinstance(o,dict)}\n            extra=[ip for ip in row.get(\'source_ips\',[]) if ip not in linked]\n            append_table(label+\' \xc2\xb7 \xec\xb6\x94\xea\xb0\x80 \xea\xb4\x80\xec\xb8\xa1 \xec\xa3\xbc\xec\x86\x8c(\xec\x8b\x9c\xea\xb0\x81 \xeb\x8c\x80\xec\x9d\x91 \xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8)\',(\'\xeb\xb2\x88\xed\x98\xb8\',\'\xec\xb6\x9c\xeb\xb0\x9c\xec\xa7\x80 IP\'),\n                         list(enumerate(extra,1)))\n        elif kind==\'containment_clock\':\n            state=row.get(\'live_block_state\');state=state if state in (\'owned\',\'absent\',\'foreign\',\'unavailable\') else \'\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\'\n            labels=CONTAINMENT_TIME_LABELS\n            times=[]\n            for key,label in labels.items():\n                v=row.get(\'times\',{}).get(key)\n                if parse_instant(v):times.append((label,stamp(v)))\n            if not row.get(\'initial_apply_time_verified\'):times.append((\'\xec\xb5\x9c\xec\xb4\x88 \xec\xa0\x81\xec\x9a\xa9 \xed\x99\x95\xec\x9d\xb8 \xec\x8b\x9c\xea\xb0\x81 \xeb\xaf\xb8\xea\xb8\xb0\xeb\xa1\x9d\xc2\xb7\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\',\'\xea\xb8\xb0\xed\x95\x9c/TTL \xec\x97\xad\xec\x82\xb0 \xec\x95\x84\xeb\x8b\x98\'))\n            request_id=str(row.get(\'request_id\',\'\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\'))\n            rows.append((\'\xec\x8b\xa4\xec\xa0\x9c \xec\xb0\xa8\xeb\x8b\xa8 \xea\xb4\x80\xec\xb8\xa1\',state+\' / \'+str(row.get(\'ip\',\'\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\')),\'\xec\x9a\x94\xec\xb2\xad \'+request_id+\'; \xec\x8b\x9c\xea\xb0\x81\xec\x9d\x80 \xeb\xb3\x84\xeb\x8f\x84 \xec\x9d\xb4\xeb\xa0\xa5 \xed\x91\x9c\'))\n            append_table(\'\xec\xb0\xa8\xeb\x8b\xa8 \xec\x9d\xb4\xeb\xa0\xa5 \xc2\xb7 \'+request_id,(\'\xec\x8b\x9c\xea\xb0\x81 \xea\xb5\xac\xeb\xb6\x84\',\'\xec\x8b\x9c\xea\xb0\x81(KST)\xc2\xb7\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8 \xeb\xb2\x94\xec\x9c\x84\'),times)\n        elif kind==\'proposal_status\':\n            rows.append((\'\xec\x9a\x94\xec\xb2\xad \xec\x8b\xa4\xed\x96\x89 \xea\xb8\xb0\xeb\xa1\x9d\',row.get(\'status\',\'\xec\x83\x81\xed\x83\x9c \xec\x84\xb8\xeb\xb6\x80\xea\xb0\x92 \xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\'),\n                         str(row.get(\'target\',\'\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\'))+\' / \'+str(row.get(\'proposal_id\',\'\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\'))+\'; \xec\x8a\xb9\xec\x9d\xb8\xc2\xb7\xec\x8b\xa4\xec\xa0\x9c \xec\xb0\xa8\xeb\x8b\xa8 \xea\xb4\x80\xec\xb8\xa1\xea\xb3\xbc \xeb\xb3\x84\xea\xb0\x9c\'))\n        elif kind==\'agent_inventory\':\n            for agent in row.get(\'agents\',[]):\n                rows.append((\'\xeb\x93\xb1\xeb\xa1\x9d \xec\x97\x90\xec\x9d\xb4\xec\xa0\x84\xed\x8a\xb8\',str(agent.get(\'name\',\'\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\')),\n                             \'ID \'+str(agent.get(\'agent_id\',agent.get(\'id\',\'\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\')))+\' / \xea\xb4\x80\xec\xb8\xa1 \xec\xa3\xbc\xec\x86\x8c \'+str(agent.get(\'reported_ip\',\'\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\'))))\n        elif kind==\'diagnostics\':\n            rows.extend(diagnostic_contract().diagnostic_evidence_rows(row,stamp))\n        elif kind==\'blocks\':\n            addresses=row.get(\'addresses\',[]);total=row.get(\'count\');basis=\'\xea\xb2\xbd\xeb\xb3\xb4\xc2\xb7\xec\x84\x9c\xeb\xb9\x84\xec\x8a\xa4 \xec\x83\x81\xed\x83\x9c \xec\xa1\xb0\xed\x9a\x8c\xea\xb0\x80 \xec\x95\x84\xeb\x8b\x98\'\n            if type(total) is int and total>len(addresses):\n                basis+=\'; \xec\xa3\xbc\xec\x86\x8c \'+str(len(addresses))+\'/\'+str(total)+\'\xea\xb0\x9c \xed\x91\x9c\xec\x8b\x9c\xc2\xb7\xeb\x82\x98\xeb\xa8\xb8\xec\xa7\x80 \'+str(total-len(addresses))+\'\xea\xb0\x9c \xed\x91\x9c\xec\x8b\x9c \xeb\xaf\xb8\xec\x99\x84\xeb\xa3\x8c\'\n            rows.append((\'\xec\xb0\xa8\xeb\x8b\xa8 \xeb\xaa\xa9\xeb\xa1\x9d\',\'\xed\x98\x84\xec\x9e\xac \xed\x95\xad\xeb\xaa\xa9 \'+count(total)+\'\xea\xb0\x9c\',basis))\n            append_table(\'\xed\x98\x84\xec\x9e\xac \xec\xb0\xa8\xeb\x8b\xa8 \xec\xa3\xbc\xec\x86\x8c\',(\'\xeb\xb2\x88\xed\x98\xb8\',\'IP \xec\xa3\xbc\xec\x86\x8c\'),list(enumerate(addresses,1)))\n        else:\n            # Non-event evidence already has bounded, literal labels. Do not\n            # expose dictionary repr/JSON or model-provided prose as a table.\n            text=literal_evidence_summary([row])\n            if text:rows.append((\'\xea\xb8\xb0\xed\x83\x80 \xec\xa1\xb0\xed\x9a\x8c \xea\xb7\xbc\xea\xb1\xb0\',str(kind),text.replace(\'\\n\',\'; \')))\n    remaining=[]\n    for value in deferred:\n        instant=parse_instant(value)\n        if instant and instant not in shown_times and instant not in summary_event_times:\n            rendered=stamp(value)\n            if rendered not in remaining:remaining.append(rendered)\n    append_table(\'\xec\xa1\xb0\xed\x9a\x8c \xea\xb5\xac\xea\xb0\x84\',(\'\xec\xa1\xb0\xed\x9a\x8c \xeb\x8c\x80\xec\x83\x81\',\'\xec\x8b\x9c\xec\x9e\x91(KST)\',\'\xec\xa2\x85\xeb\xa3\x8c(KST)\'),windows)\n    append_table(\'\xea\xb4\x80\xec\xb8\xa1 \xec\x8b\x9c\xec\xa0\x90\',(\'\xea\xb4\x80\xec\xb8\xa1 \xeb\x8c\x80\xec\x83\x81\',\'\xea\xb4\x80\xec\xb8\xa1 \xec\x8b\x9c\xea\xb0\x81(KST)\'),observed)\n    append_table(\'\xea\xb8\xb0\xed\x83\x80 \xea\xb4\x80\xec\xb8\xa1 \xec\x8b\x9c\xea\xb0\x81\',(\'\xeb\xb2\x88\xed\x98\xb8\',\'\xec\x8b\x9c\xea\xb0\x81(KST)\'),list(enumerate(remaining,1)))\n    if not rows:rows=[(\'\xec\xa1\xb0\xed\x9a\x8c \xea\xb7\xbc\xea\xb1\xb0\',\'\xea\xb5\xac\xec\xa1\xb0\xed\x99\x94\xed\x95\xb4 \xed\x91\x9c\xec\x8b\x9c\xed\x95\xa0 \xea\xb7\xbc\xea\xb1\xb0 \xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\',\'\xeb\x88\x84\xeb\x9d\xbd\xc2\xb7\xec\x8b\xa4\xed\x8c\xa8 \xec\x9b\x90\xeb\xac\xb8\xea\xb3\xbc \xec\x8b\xa4\xec\xa0\x9c \xed\x98\xb8\xec\xb6\x9c \xea\xb8\xb0\xeb\xa1\x9d \xed\x99\x95\xec\x9d\xb8 \xed\x95\x84\xec\x9a\x94\')]\n    table=[\'| \xed\x99\x95\xec\x9d\xb8 \xed\x95\xad\xeb\xaa\xa9 | \xec\xa1\xb0\xed\x9a\x8c \xea\xb2\xb0\xea\xb3\xbc | \xea\xb7\xbc\xea\xb1\xb0\xc2\xb7\xeb\xb2\x94\xec\x9c\x84 |\',\'| --- | --- | --- |\']\n    table+=[\'| \'+\' | \'.join(cell(v) for v in row)+\' |\' for row in rows]\n    text=\'\\n\\n\'.join([\'\\n\'.join(table),*sections])\n    if event_details_omitted:\n        text+=\'\\n\\n\xea\xb8\xb0\xeb\xb3\xb8 \xec\x9a\x94\xec\x95\xbd \xed\x91\x9c\xec\x8b\x9c\xec\x9e\x85\xeb\x8b\x88\xeb\x8b\xa4. \xec\xa1\xb0\xed\x9a\x8c\xed\x95\x9c \xea\xb2\xbd\xeb\xb3\xb4\xec\x9d\x98 \xea\xb0\x9c\xeb\xb3\x84 \xea\xb4\x80\xec\xb8\xa1\xc2\xb7\xec\xa3\xbc\xec\x86\x8c\xc2\xb7\xea\xb7\x9c\xec\xb9\x99 ID\xc2\xb7\xec\x8b\x9c\xea\xb0\x81\xec\x9d\x80 \xed\x91\x9c\xec\x8b\x9c\xec\x97\x90\xec\x84\x9c \xec\x83\x9d\xeb\x9e\xb5\xed\x96\x88\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4. \xea\xb0\x9c\xeb\xb3\x84 \xea\xb2\xbd\xeb\xb3\xb4 \xec\x83\x81\xec\x84\xb8\xeb\xa5\xbc \xec\x9a\x94\xec\xb2\xad\xed\x95\x98\xeb\xa9\xb4 \xec\x83\x81\xec\x84\xb8 \xed\x91\x9c\xeb\xa1\x9c \xed\x99\x95\xec\x9d\xb8\xed\x95\xa0 \xec\x88\x98 \xec\x9e\x88\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4. \xec\x8b\xa4\xec\xa0\x9c \xec\xa1\xb0\xed\x9a\x8c \xec\x9b\x90\xeb\xac\xb8\xea\xb3\xbc \xea\xb2\x80\xec\xa6\x9d \xeb\xb2\x94\xec\x9c\x84\xeb\x8a\x94 \xec\xa4\x84\xec\x9d\xb4\xec\xa7\x80 \xec\x95\x8a\xec\x95\x98\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4.\'\n    return text\n\n\ndef factual_review_report(facts, *, event_details=True):\n    return (\'\xeb\xaa\xa8\xeb\x8d\xb8\xec\x9d\x98 \xec\xb5\x9c\xec\xa2\x85 \xed\x8c\x90\xeb\x8b\xa8\xec\x9d\xb4 \xec\x99\x84\xeb\xa3\x8c\xeb\x90\x98\xec\xa7\x80 \xec\x95\x8a\xec\x95\x98\xea\xb1\xb0\xeb\x82\x98 \xec\xa1\xb0\xed\x9a\x8c \xea\xb7\xbc\xea\xb1\xb0\xec\x99\x80 \xec\x9d\xbc\xec\xb9\x98\xed\x95\x98\xec\xa7\x80 \xec\x95\x8a\xec\x95\x84 \xec\xb6\x94\xea\xb0\x80 \xea\xb2\x80\xed\x86\xa0\xea\xb0\x80 \xed\x95\x84\xec\x9a\x94\xed\x95\xa9\xeb\x8b\x88\xeb\x8b\xa4.\\n\\n\'+\n            literal_evidence_table(facts,event_details=event_details)+\'\\n\\n\xed\x8c\x90\xeb\x8b\xa8\xc2\xb7\xec\xa1\xb0\xec\xb9\x98\xec\x9d\x98 \xec\x99\x84\xeb\xa3\x8c\xeb\xa5\xbc \xeb\x9c\xbb\xed\x95\x98\xec\xa7\x80 \xec\x95\x8a\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4. \xec\x83\x81\xec\x84\xb8 \xec\x9b\x90\xeb\xac\xb8\xec\x9d\x80 \xea\xb0\x90\xec\x82\xac \xea\xb8\xb0\xeb\xa1\x9d\xec\x97\x90 \xeb\xb3\xb4\xec\xa1\xb4\xed\x95\xa9\xeb\x8b\x88\xeb\x8b\xa4.\\nMANAGEMENT_STATUS: needs_review\')\n\n\ndef render_model_review(report, facts, *, event_details=True):\n    """Model owns judgment; receipts supply the table without model retyping."""\n    if report.get(\'scope\')==\'verified_service_lookup\':\n        return diagnostic_contract().service_lookup_report(literal_evidence_table(facts))\n    contract=diagnostic_contract()\n    if contract.diagnostic_facts_only(facts) and contract.diagnostic_report_field_violations(report):\n        raise ValueError(\'diagnostic_report_empty_field\')\n    line=contract.report_field_display\n    basis=line(report[\'basis\'])\n    text=\'**\xed\x8c\x90\xeb\x8b\xa8**\\n\'+basis\n    if \'current_observation\' in report:\n        text+=\'\\n\\n**\xed\x98\x84\xec\x9e\xac \xec\xb2\x98\xeb\xa6\xac \xec\x83\x81\xed\x83\x9c**\\n\'+line(report[\'current_observation\'])\n    text+=\'\\n\\n\'+literal_evidence_table(facts,event_details=event_details)\n    items=contract.report_list_display\n    text+=\'\\n\\n**\xeb\xaf\xb8\xed\x99\x95\xec\x9d\xb8\xc2\xb7\xed\x95\x9c\xea\xb3\x84**\\n\'+items(report[\'limitations\'])\n    text+=\'\\n\\n**\xeb\x8b\xa4\xec\x9d\x8c \xec\xa1\xb0\xec\xb9\x98**\\n\'+items(contract.service_follow_up_lines(report[\'next_steps\']))\n    disposition={k:report[k] for k in (\'assessment\',\'basis\',\'evidence_tools\')}\n    return text+\'\\n\\nINCIDENT_DISPOSITION: \'+json.dumps(disposition,ensure_ascii=False)+\'\\nMANAGEMENT_STATUS: \'+report[\'status\']\n\n\ndef management_status(text):\n    """Read one terminal model conclusion; never infer it from prose."""\n    if not isinstance(text, str):\n        return None\n    matches = list(re.finditer(r\'^MANAGEMENT_STATUS:[^\\r\\n]*$\', text, re.M))\n    if len(matches) != 1 or text[matches[0].end():].strip():\n        return None\n    value = re.fullmatch(r\'MANAGEMENT_STATUS: (resolved|monitor|needs_review|awaiting_approval)[ \\t]*\', matches[0].group())\n    return value.group(1) if value else None\n\n\ndef management_status_problem(text):\n    """Say exactly why management_status() rejected the report.\n\n    11-13 23:13: the model wrote the status line and then INCIDENT_DISPOSITION\n    after it, was told only the issue code, believed the line was missing and\n    repeated the same order twice. A diagnosis, never a rewrite.\n    """\n    if not isinstance(text, str) or management_status(text) is not None:\n        return None\n    matches = list(re.finditer(r\'^MANAGEMENT_STATUS:[^\\r\\n]*$\', text, re.M))\n    if not matches:\n        formatted = formatted_control_line(text, \'MANAGEMENT_STATUS\')\n        if formatted:\n            # Show the model\'s own value without marks; never suggest a status.\n            bare = CONTROL_LINE_FORMATTING.sub(\'\', formatted).strip().lstrip(\'>-\').strip()\n            bare = re.sub(r\'^MANAGEMENT_STATUS\\s*:\\s*\', \'MANAGEMENT_STATUS: \', bare)\n            example = (bare if re.fullmatch(r\'MANAGEMENT_STATUS: (resolved|monitor|needs_review|awaiting_approval)\', bare)\n                       else \'MANAGEMENT_STATUS: \xeb\x92\xa4\xec\x97\x90 resolved\xc2\xb7monitor\xc2\xb7needs_review\xc2\xb7awaiting_approval \xec\xa4\x91 \xec\x8b\xa4\xec\xa0\x9c \xed\x8c\x90\xeb\x8b\xa8 \xed\x95\x98\xeb\x82\x98\')\n            return (\'MANAGEMENT_STATUS \xec\xa4\x84\xec\x97\x90 \xec\x84\x9c\xec\x8b\x9d(\xeb\xb0\xb1\xed\x8b\xb1\xc2\xb7\xea\xb5\xb5\xea\xb2\x8c\xc2\xb7\xec\x9d\xb8\xec\x9a\xa9\xeb\xb6\x80\xed\x98\xb8\xc2\xb7\xeb\xaa\xa9\xeb\xa1\x9d \xea\xb8\xb0\xed\x98\xb8)\xec\x9d\xb4 \xeb\xb6\x99\xec\x96\xb4 \xec\x9d\xb8\xec\x8b\x9d\xeb\x90\x98\xec\xa7\x80 \xec\x95\x8a\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4: \'\n                    + json.dumps(formatted, ensure_ascii=False) + \'. \xec\x84\x9c\xec\x8b\x9d \xec\x97\x86\xec\x9d\xb4 \xec\xa4\x84 \xeb\xa7\xa8 \xec\x95\x9e\xeb\xb6\x80\xed\x84\xb0 \' + example + \' \xed\x98\x95\xec\x8b\x9d\xec\x9c\xbc\xeb\xa1\x9c \xec\x93\xb0\xec\x84\xb8\xec\x9a\x94.\')\n        return \'MANAGEMENT_STATUS \xec\xa4\x84\xec\x9d\xb4 \xec\x97\x86\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4.\'\n    if len(matches) > 1:\n        return \'MANAGEMENT_STATUS \xec\xa4\x84\xec\x9d\xb4 \' + str(len(matches)) + \'\xea\xb0\x9c\xec\x9e\x85\xeb\x8b\x88\xeb\x8b\xa4. \xed\x95\x98\xeb\x82\x98\xeb\xa7\x8c \xec\x93\xb0\xec\x84\xb8\xec\x9a\x94.\'\n    if not re.fullmatch(r\'MANAGEMENT_STATUS: (resolved|monitor|needs_review|awaiting_approval)[ \\t]*\', matches[0].group()):\n        return \'MANAGEMENT_STATUS \xea\xb0\x92\xec\x9d\xb4 resolved\xc2\xb7monitor\xc2\xb7needs_review\xc2\xb7awaiting_approval \xec\xa4\x91 \xed\x95\x98\xeb\x82\x98\xea\xb0\x80 \xec\x95\x84\xeb\x8b\x99\xeb\x8b\x88\xeb\x8b\xa4.\'\n    after = text[matches[0].end():].strip().splitlines()[0]\n    if after.startswith(\'```\'):\n        return (\'MANAGEMENT_STATUS \xec\xa4\x84 \xeb\x92\xa4\xec\x97\x90 \xec\xbd\x94\xeb\x93\x9c \xeb\xb8\x94\xeb\xa1\x9d \xeb\x8b\xab\xeb\x8a\x94 \xed\x91\x9c\xec\x8b\x9c(```)\xea\xb0\x80 \xec\x9e\x88\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4. \xeb\xb3\xb4\xea\xb3\xa0\xec\x84\x9c\xeb\x82\x98 \xec\xa0\x9c\xec\x96\xb4 \xec\xa4\x84\xec\x9d\x84 \xec\xbd\x94\xeb\x93\x9c \xeb\xb8\x94\xeb\xa1\x9d\xec\x9c\xbc\xeb\xa1\x9c \xea\xb0\x90\xec\x8b\xb8\xec\xa7\x80 \xeb\xa7\x90\xea\xb3\xa0 \'\n                \'MANAGEMENT_STATUS \xec\xa4\x84\xec\x9d\x84 \xec\x9d\x91\xeb\x8b\xb5\xec\x9d\x98 \xeb\xa7\xa8 \xeb\xa7\x88\xec\xa7\x80\xeb\xa7\x89 \xec\xa4\x84\xeb\xa1\x9c \xec\x93\xb0\xec\x84\xb8\xec\x9a\x94.\')\n    what = (\'INCIDENT_DISPOSITION \xec\xa4\x84\' if CONTROL_LINE_FORMATTING.sub(\'\', after).strip().startswith(\'INCIDENT_DISPOSITION\')\n            else \'\xeb\x8b\xa4\xeb\xa5\xb8 \xeb\x82\xb4\xec\x9a\xa9\')\n    return (\'MANAGEMENT_STATUS \xec\xa4\x84 \xeb\x92\xa4\xec\x97\x90 \' + what + \'\xec\x9d\xb4 \xec\x9e\x88\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4. INCIDENT_DISPOSITION \xec\xa4\x84\xec\x9d\x80 MANAGEMENT_STATUS \xec\xa4\x84 \xec\x95\x9e\xec\x97\x90 \xeb\x91\x90\xea\xb3\xa0, \'\n            \'MANAGEMENT_STATUS \xec\xa4\x84\xec\x9d\x84 \xec\x9d\x91\xeb\x8b\xb5\xec\x9d\x98 \xeb\xa7\xa8 \xeb\xa7\x88\xec\xa7\x80\xeb\xa7\x89 \xec\xa4\x84\xeb\xa1\x9c \xec\x93\xb0\xec\x84\xb8\xec\x9a\x94.\')\n\n\nCONTROL_LINE_FORMATTING = re.compile(r\'[`*"\xe2\x80\x9c\xe2\x80\x9d\xe2\x80\x98\xe2\x80\x99]\')\n\n\ndef formatted_control_line(text, key):\n    """A control line the parser cannot see because of Markdown/quote marks.\n\n    11-13 23:35: both drafts wrote "`MANAGEMENT_STATUS`: monitor" and\n    "`MANAGEMENT_STATUS: needs_review`"; the exact syntax stays required.\n    """\n    if not isinstance(text, str):\n        return None\n    for line in text.splitlines():\n        if key not in line or line.startswith(key + \':\'):\n            continue\n        bare = CONTROL_LINE_FORMATTING.sub(\'\', line).strip().lstrip(\'>-\').strip()\n        if bare.startswith(key + \':\'):\n            return line.strip()[:160]\n    return None\n\n\ndef disposition_line_problem(text):\n    """Say why an INCIDENT_DISPOSITION line was not read (formatting only)."""\n    if not isinstance(text, str) or len(re.findall(r\'^INCIDENT_DISPOSITION: [^\\r\\n]+$\', text, re.M)) == 1:\n        return None\n    formatted = formatted_control_line(text, \'INCIDENT_DISPOSITION\')\n    if not formatted:\n        return None\n    return (\'INCIDENT_DISPOSITION \xec\xa4\x84\xec\x97\x90 \xec\x84\x9c\xec\x8b\x9d(\xeb\xb0\xb1\xed\x8b\xb1\xc2\xb7\xea\xb5\xb5\xea\xb2\x8c\xc2\xb7\xec\x9d\xb8\xec\x9a\xa9\xeb\xb6\x80\xed\x98\xb8\xc2\xb7\xeb\xaa\xa9\xeb\xa1\x9d \xea\xb8\xb0\xed\x98\xb8)\xec\x9d\xb4 \xeb\xb6\x99\xec\x96\xb4 \xec\x9d\xb8\xec\x8b\x9d\xeb\x90\x98\xec\xa7\x80 \xec\x95\x8a\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4: \'\n            + json.dumps(formatted[:80] + (\'\xe2\x80\xa6\' if len(formatted) > 80 else \'\'), ensure_ascii=False)\n            + \'. \xec\x84\x9c\xec\x8b\x9d \xec\x97\x86\xec\x9d\xb4 \xec\xa4\x84 \xeb\xa7\xa8 \xec\x95\x9e\xeb\xb6\x80\xed\x84\xb0 INCIDENT_DISPOSITION: \xeb\x8b\xa4\xec\x9d\x8c\xec\x97\x90 JSON \xed\x95\x9c \xec\xa4\x84\xeb\xa1\x9c \xec\x93\xb0\xec\x84\xb8\xec\x9a\x94.\')\n\n\ndef disposition_status_conflict(text):\n    """resolved cannot close an incident the same report calls unresolved.\n\n    The controller applies this only after a sensor-incident run\n    (incident_disposition_unresolved), so the model never got a chance to\n    fix it (11-13 23:50: assessment unresolved + MANAGEMENT_STATUS resolved).\n    Only a report that carries a disposition line is checked.\n    """\n    if management_status(text) != \'resolved\':\n        return False\n    value, error = parse_incident_disposition(text)\n    return error is None and value.get(\'assessment\') == \'unresolved\'\n\n\ndef rejected_report_lines(text, facts, successful_reads, issues, limit=4):\n    """The model\'s own lines that alone reproduce a rejected issue (bounded)."""\n    wanted, rows = set(issues), []\n    if not isinstance(text, str) or not wanted:\n        return rows\n    for line in text.splitlines():\n        line = line.strip()\n        if not line or line.startswith(\'MANAGEMENT_STATUS:\'):\n            continue\n        hit = sorted(wanted & set(evidence_claim_violations(line, facts or [], successful_reads)))\n        if hit:\n            # Quote the sentence the check rejected, not the whole row: the\n            # qualifier elsewhere in the row hid what failed (11-14 01:02).\n            units = [(x.strip(\' |\'), scope) for x, scope in claim_sentences(line) if x.strip(\' |\')]\n            quote = next((x for x, scope in units if len(units) > 1 and set(hit) <= set(\n                evidence_claim_violations(scope, facts or [], successful_reads))), line)\n            rows.append({\'issues\': hit, \'line\': quote[:240]})\n            if len(rows) >= limit:\n                break\n    return rows\n\n\ndef bind_management_status(native_text, guarded_text):\n    """Formatting cannot change the model\'s control label; missing labels fail review."""\n    status = management_status(native_text)\n    label = status or \'needs_review\'\n    body = re.sub(r\'(?m)^MANAGEMENT_STATUS:[^\\n]*\\n?\', \'\', guarded_text).strip()\n    if status is None:\n        body += \'\\n\xea\xb4\x80\xeb\xa6\xac \xec\x83\x81\xed\x83\x9c \xed\x91\x9c\xec\xa7\x80\xec\x9d\x98 \xeb\x88\x84\xeb\x9d\xbd\xc2\xb7\xed\x98\x95\xec\x8b\x9d \xec\x98\xa4\xeb\xa5\x98\xeb\xa1\x9c \xec\xb6\x94\xea\xb0\x80 \xea\xb2\x80\xed\x86\xa0\xea\xb0\x80 \xed\x95\x84\xec\x9a\x94\xed\x95\xa9\xeb\x8b\x88\xeb\x8b\xa4.\'\n    return body + \'\\nMANAGEMENT_STATUS: \' + label\n\n\ndef current_management_request(user):\n    marker = \'\\nTRUSTED_CURRENT_REQUEST_JSON\\n\'\n    if marker in user:\n        try:\n            value = json.loads(user.rsplit(marker, 1)[1])\n            if set(value) == {\'request\'} and isinstance(value[\'request\'], str) and len(value[\'request\']) <= 16384:\n                return value[\'request\']\n        except (ValueError, TypeError):\n            pass\n    return user if len(user) <= 16384 else \'\xec\x9b\x90\xeb\xb3\xb8 \xed\x98\x84\xec\x9e\xac \xec\x82\xac\xec\x9a\xa9\xec\x9e\x90 \xec\x9a\x94\xec\xb2\xad\xec\x9d\x84 \xeb\x8b\xa4\xec\x8b\x9c \xed\x99\x95\xec\x9d\xb8\xed\x95\x98\xec\x84\xb8\xec\x9a\x94. \xea\xb6\x8c\xed\x95\x9c\xea\xb3\xbc \xec\xa6\x9d\xea\xb1\xb0\xec\x9d\x98 \xea\xb5\xac\xeb\xb6\x84\xec\x9d\x80 \xec\x9c\xa0\xec\xa7\x80\xed\x95\xa9\xeb\x8b\x88\xeb\x8b\xa4.\'\n\n\ndef readonly_incident_review():\n    """Root-only review profile; user/log text cannot activate a followup."""\n    if not all(os.environ.get(k)==v for k,v in (\n            (\'CAPSTONE_MANAGEMENT_MODE\',\'verify\'),(\'CAPSTONE_MANAGEMENT_REVIEW\',\'1\'),\n            (\'CAPSTONE_WEB_IMPACT_REVIEW\',\'1\'))):return False\n    if os.environ.get(\'CAPSTONE_OPERATOR_REVIEW\')==\'1\':return True\n    if os.environ.get(\'CAPSTONE_AUTOMATIC_REVIEW\')!=\'1\':return False\n    context=compact_controller_context()\n    history=context[\'evidence_scope\'].get(\'automatic_followup\') if context else None\n    if not isinstance(history,dict):return False\n    report=history.get(\'report\');prior=history.get(\'prior_run_id\')\n    return (history.get(\'trigger\')==\'automatic_readonly_followup\'\n        and isinstance(prior,str) and re.fullmatch(r\'[0-9a-f]{32}\',prior) is not None\n        and isinstance(report,str) and 0<len(report.encode())<=10000\n        and history.get(\'report_sha256\')==hashlib.sha256(report.encode()).hexdigest())\n\n\ndef management_reasoning(request, agent, *, required_read_phase=False):\n    """Use the verified Ollama compatibility control in this process only."""\n    extra = dict(request.get(\'extra_body\') or {})\n    if (getattr(agent, \'provider\', None) != \'custom\'\n            or str(getattr(agent, \'base_url\', \'\')).rstrip(\'/\') not in {\n                \'http://211.170.162.111:11434/v1\', \'http://10.200.10.10:11435/v1\'}\n            or not verified_runtime_model(agent, extra.get(\'model\', request.get(\'model\')))):\n        return request\n    result = dict(request)\n    for key in (\'think\', \'reasoning_effort\', \'reasoning\'):\n        result.pop(key, None)\n        extra.pop(key, None)\n    # This route\'s /api/show confirms boolean thinking. Its OpenAI adapter\n    # accepts reasoning_effort, not the native /api/chat "think" field.\n    # A recognized non-none effort maps to true for a boolean-only model.\n    review = os.environ.get(\'CAPSTONE_MANAGEMENT_REVIEW\') == \'1\' and os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\') == \'verify\'\n    operator_review = review and (os.environ.get(\'CAPSTONE_OPERATOR_REVIEW\') == \'1\' or readonly_incident_review())\n    # Only trusted, still-unmet concrete reads use this phase. The next build\n    # restores the existing reasoning profile before risk/closure assessment.\n    lookup=required_read_phase is True and os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\')==\'verify\'\n    if review:\n        result.pop(\'max_completion_tokens\', None)\n        result[\'max_tokens\'] = 6144 if operator_review and not lookup else 2048\n    chat=chat_read_context();catalog=request\n    bound=getattr(agent,\'_capstone_registered_read_conditions\',None)\n    if bound is not None:\n        catalog={\'tools\':[]}\n        if isinstance(bound,tuple) and len(bound)==2 and bound[0]==getattr(agent,\'_current_turn_id\',None) and isinstance(bound[1],dict):\n            names={t.get(\'function\',{}).get(\'name\') for t in request.get(\'tools\',[])}\n            catalog={\'tools\':[{\'function\':{\'name\':n,\'parameters\':s}} for n,s in bound[1].items() if n in names]}\n    service=diagnostic_contract().service_history_plan(catalog,chat[\'request\'],chat[\'requested_at_kst\']) if chat else None\n    service_lookup=bool(service and service.get(\'compact_scope\') and not service.get(\'unavailable_capabilities\'))\n    if service_lookup:print(\'management_service_reasoning \'+json.dumps({\'reasoning_effort\':\'none\',\'registered_targets\':sorted(service[\'units\'])}),file=sys.stderr)\n    # A mandatory choice among registered reads has no risk/actuator decision.\n    # Auto choice and any mixed read/write catalog keep the judgment profile.\n    choices=request.get(\'tools\');choice=request.get(\'tool_choice\')\n    read_names=[t.get(\'function\',{}).get(\'name\') for t in choices if isinstance(t,dict)] if isinstance(choices,list) else []\n    required_choice=choice==\'required\' or (isinstance(choice,dict) and choice.get(\'type\')==\'function\'\n        and isinstance(choice.get(\'function\'),dict) and choice[\'function\'].get(\'name\') in read_names)\n    selected_read=bool(required_choice and isinstance(choices,list) and 1<=len(choices)<=64\n        and len(read_names)==len(choices) and all(isinstance(n,str) and allowed(n,\'verify\')\n            and n in getattr(agent,\'valid_tool_names\',()) for n in read_names)\n        and not {\'tools\',\'tool_choice\',\'messages\',\'model\'} & set(extra)\n        and os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\') in (\'manage\',\'verify\'))\n    if lookup or service_lookup or selected_read:\n        result.pop(\'max_completion_tokens\',None);result[\'max_tokens\']=2048\n    return {**result, \'reasoning_effort\': \'none\' if lookup or service_lookup or selected_read or review and not operator_review else \'medium\', \'extra_body\': extra}\n\n\nLITERAL_REPAIR_ISSUES = frozenset({\n    \'containment_deadline_clock_mismatch\', \'containment_deadline_requires_kst_display\',\n    \'containment_initial_application_time_unverified\', \'containment_registration_time_unverified\',\n    \'containment_time_role_mismatch\', \'containment_time_role_requires_kst\',\n    \'sample_zero_presented_as_absence\', \'sample_count_presented_as_window_total\',\n    \'unknown_window_total_claimed\', \'missing_or_invalid_management_status\',\n    \'unresolved_disposition_marked_resolved\',\n    \'invalid_disposition_tool_names\',\n    \'web_continuity_unverified_is_not_outage\',\n    \'diagnostic_snapshot_is_not_functional_health\',\n    \'diagnostic_relative_time_requires_calculation\',\n})\n\n\ndef citation_name_repair(text, successful_reads, catalog):\n    """Unknown citation spellings are not a demand to repeat successful reads.\n\n    Never map aliases, manufacture a receipt, or excuse a known unqueried tool.\n    Only an unresolved report with actual citations can use literal correction.\n    """\n    if not isinstance(text, str) or management_status(text) not in (\'needs_review\', \'monitor\'):\n        return False\n    lines = re.findall(r\'^INCIDENT_DISPOSITION: ([^\\r\\n]+)$\', text, re.M)\n    if len(lines) != 1:\n        return False\n    try:\n        decision = json.loads(lines[0])\n        if (not isinstance(decision, dict) or decision.get(\'assessment\') != \'unresolved\'\n                or disposition_citation_violations(text, successful_reads) != [\'unobserved_disposition_tools\']):\n            return False\n        cited = set(decision[\'evidence_tools\'])\n        completed = set(successful_reads or ())\n        registered = {tool[\'function\'][\'name\'] for tool in permitted_tools(catalog, \'verify\')}\n        missing = cited - completed\n        return bool(registered and missing and cited & completed and not missing & registered)\n    except (ValueError, TypeError, KeyError, RecursionError):\n        return False\n\n\ndef citation_note_text(successful_reads):\n    """The exact-citation hint for this run\'s real successful receipts, or None."""\n    if os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\') != \'verify\':\n        return None\n    names = sorted({name for name in successful_reads if isinstance(name, str) and allowed(name, \'verify\')})\n    if not names or len(names) > 64:\n        return None\n    return (\'\xed\x98\x84\xec\x9e\xac \xec\x8b\xa4\xed\x96\x89\xec\x9d\x98 \xec\x8b\xa4\xec\xa0\x9c \xec\x84\xb1\xea\xb3\xb5 \xec\x9d\xbd\xea\xb8\xb0 \xeb\x8f\x84\xea\xb5\xac \xec\x9d\xb4\xeb\xa6\x84(\xed\x8c\x90\xeb\x8b\xa8\xc2\xb7\xec\x98\x81\xed\x96\xa5 \xed\x99\x95\xec\x9d\xb8\xec\x9d\x98 \xec\xa6\x9d\xeb\xaa\x85\xec\x9d\x80 \xec\x95\x84\xeb\x8b\x98): \' +\n        json.dumps(names, ensure_ascii=False) +\n        \'\\nINCIDENT_DISPOSITION.evidence_tools\xec\x97\x90\xeb\x8a\x94 \xec\x9d\xb8\xec\x9a\xa9\xed\x95\x9c \xec\x8b\xa4\xec\xa0\x9c \xea\xb7\xbc\xea\xb1\xb0\xec\x9d\x98 \xec\x9d\xb4\xeb\xa6\x84\xec\x9d\x84 \xec\x9d\xb4 \xeb\xaa\xa9\xeb\xa1\x9d\xec\x97\x90\xec\x84\x9c \xec\xa0\x95\xed\x99\x95\xed\x9e\x88 \xeb\xb3\xb5\xec\x82\xac\xed\x95\x98\xec\x84\xb8\xec\x9a\x94. \'\n        \'\xea\xb5\xac\xeb\xb6\x84\xec\x9e\x90\xeb\x82\x98 \xec\x84\x9c\xeb\xb2\x84 \xec\x9d\xb4\xeb\xa6\x84\xec\x9d\x84 \xeb\xb0\x94\xea\xbe\xb8\xec\xa7\x80 \xeb\xa7\x88\xec\x84\xb8\xec\x9a\x94. \xec\xb6\x94\xea\xb0\x80 \xea\xb7\xbc\xea\xb1\xb0\xea\xb0\x80 \xed\x95\x84\xec\x9a\x94\xed\x95\x98\xeb\xa9\xb4 \xec\x8b\xa4\xec\xa0\x9c \xec\xa1\xb0\xed\x9a\x8c\xed\x95\x9c \xeb\x92\xa4 \xec\x9d\xb8\xec\x9a\xa9\xed\x95\x98\xec\x84\xb8\xec\x9a\x94.\')\n\n\ndef _rows_digest(rows):\n    return hashlib.sha256(json.dumps(rows, ensure_ascii=False, sort_keys=True, default=str).encode()).hexdigest()\n\n\ndef completed_citation_request(request, successful_reads, notes=None):\n    """Model-only exact citation names from this run\'s real successful receipts.\n\n    The system message stays byte-identical for the whole run. Appending the\n    growing name list to it changed the first prompt tokens on every call, and\n    the hybrid model on the inference server can only resume at the end of an\n    earlier prompt, so each call re-read the full 30-65k-token prompt (Thor log\n    and session replay, 2026-11-13). Instead each changed list is shown once as\n    a user-role note at the conversation point where it became true, and later\n    requests of the same process repeat earlier notes at the same points, so a\n    request extends the previous one. The latest note is the current list. Notes\n    live only in this process\'s API requests: never persisted, never dispatched.\n    `notes` is the caller-owned per-process list of (anchor, prefix digest, text).\n    """\n    if not isinstance(request, dict):\n        return request\n    rows = request.get(\'messages\')\n    text = citation_note_text(successful_reads)\n    notes = [] if notes is None else notes\n    if not isinstance(rows, list) or (text is None and not notes):\n        return request\n    kept = []\n    for anchor, digest, note in notes:  # A rewritten history drops later notes.\n        if anchor > len(rows) or _rows_digest(rows[:anchor]) != digest:\n            break\n        kept.append((anchor, digest, note))\n    notes[:] = kept\n    if text is not None and (not notes or notes[-1][2] != text):\n        notes.append((len(rows), _rows_digest(rows), text))\n    if not notes:\n        return request\n    shown, queue = [], list(notes)\n    for index, row in enumerate(rows):\n        while queue and queue[0][0] == index:\n            shown.append({\'role\': \'user\', \'content\': queue.pop(0)[2]})\n        shown.append(row)\n    shown.extend({\'role\': \'user\', \'content\': note[2]} for note in queue)\n    return {**request, \'messages\': shown}\n\n\ndef completed_web_review_request(request, agent, successful_reads, *, requirements_complete=False, component_reads=()):\n    \'Require actual completed sensor reads before compact web review.\'\n    required = {\'mcp__security_events__get_web_service_target\',\n        \'mcp__security_events__search_wazuh_alerts\', \'mcp__security_events__search_web_access\'}\n    if (requirements_complete is not True or os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\') != \'verify\'\n            or os.environ.get(\'CAPSTONE_MANAGEMENT_REVIEW\') != \'1\'\n            or not readonly_incident_review()\n            or os.environ.get(\'CAPSTONE_WEB_IMPACT_REVIEW\') != \'1\'\n            or not required <= (set(successful_reads or ()) | set(component_reads))\n            or getattr(agent, \'_interrupt_requested\', False)):\n        return request\n    result = management_reasoning(request, agent, required_read_phase=True)\n    if result is request or result.get(\'reasoning_effort\') != \'none\':\n        return request\n    result[\'max_tokens\'] = 3072\n    sys.stderr.write(\'management_completed_web_review_profile \' + json.dumps({\n        \'reasoning_effort\': \'none\', \'max_tokens\': 3072, \'required_reads_complete\': True,\n        \'protected_actions_allowed\': False}) + \'\\n\')\n    return result\n\n\ndef arm_literal_repair(agent, turn, issues):\n    \'One verified read-only formatting/evidence correction, never risk reasoning.\'\n    build = getattr(agent, \'_build_api_kwargs\', None)\n    if (os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\') != \'verify\' or not callable(build)\n            or not issues or not set(issues) <= LITERAL_REPAIR_ISSUES):\n        return False\n    own = \'_build_api_kwargs\' in getattr(agent, \'__dict__\', {})\n    old = agent.__dict__.get(\'_build_api_kwargs\') if own else None\n\n    def restore():\n        if getattr(agent, \'_build_api_kwargs\', None) is once:\n            if own: agent._build_api_kwargs = old\n            else: delattr(agent, \'_build_api_kwargs\')\n        if getattr(agent, \'_capstone_grounding_restore\', None) is restore:\n            delattr(agent, \'_capstone_grounding_restore\')\n\n    @functools.wraps(build)\n    def once(*args, **kwargs):\n        restore()\n        value = build(*args, **kwargs)\n        if getattr(agent, \'_current_turn_id\', None) != turn or getattr(agent, \'_interrupt_requested\', False):\n            return value\n        result = management_reasoning(value, agent, required_read_phase=True)\n        if result is not value and result.get(\'reasoning_effort\') == \'none\':\n            sys.stderr.write(\'management_literal_repair_profile \' + json.dumps({\n                \'issues\': sorted(set(issues)), \'reasoning_effort\': \'none\', \'max_tokens\': result.get(\'max_tokens\'),\n                \'tool_count\': len(result.get(\'tools\', [])), \'protected_actions_allowed\': False}) + \'\\n\')\n        return result\n\n    agent._build_api_kwargs = once\n    agent._capstone_grounding_restore = restore\n    return True\n\n\ndef status_read_requirements(raw):\n    if raw is None:\n        return []\n    try:\n        value = json.loads(raw)\n        if not isinstance(value, list) or not 1 <= len(value) <= 32:\n            raise ValueError()\n        for row in value:\n            if (not isinstance(row, dict) or set(row) != {\'proposal_id\',\'target\'} or\n                    not isinstance(row[\'proposal_id\'], str) or not re.fullmatch(r\'[0-9a-f]{32}\', row[\'proposal_id\']) or\n                    row[\'target\'] not in (\'a:modsecurity-custom\',\'a:suricata-local\',\'b:wazuh-local-rules\',\n                        \'a:waf\',\'a:suricata\',\'a:chatproxy\',\'b:wazuh-manager\',\'b:wazuh-dashboard\',\'a:incident-ip\',\n                        \'a:vector\',\'a:wazuh-agent\',\'b:wazuh-agent\')):\n                raise ValueError()\n        return value\n    except (ValueError, TypeError):\n        raise RuntimeError(\'status_read_requirements_invalid\') from None\n\n\ndef status_read_request(row):\n    rule=row[\'target\'] in (\'a:modsecurity-custom\',\'a:suricata-local\',\'b:wazuh-local-rules\')\n    return {\'tool\':\'mcp__rule_\'+row[\'target\'][0]+\'__\'+\n            (\'get_rule_change_status\' if rule else \'get_operation_status\'),\n            \'arguments\':{\'proposal_id\' if rule else \'request_id\':row[\'proposal_id\']}}\n\n\nSENSOR_SEARCH_TOOLS = {\'mcp__security_events__search_modsecurity_alerts\',\n                       \'mcp__security_events__search_suricata_alerts\'}\n\n\ndef sensor_read_requirements(raw):\n    """Root navigation metadata only; no log text, write tools or decisions."""\n    if raw is None:return []\n    try:\n        value=json.loads(raw)\n        if not isinstance(value,list) or not 1<=len(value)<=32:raise ValueError()\n        for row in value:\n            if not isinstance(row,dict) or set(row)!={\'tool\',\'arguments\'} or row[\'tool\'] not in SENSOR_SEARCH_TOOLS:\n                raise ValueError()\n            args=row[\'arguments\']\n            if not isinstance(args,dict) or set(args)!={\'source_ip\',\'since_kst\',\'until_kst\',\'limit\'}:raise ValueError()\n            if not literal_ip(args[\'source_ip\']) or type(args[\'limit\']) is not int or not 1<=args[\'limit\']<=50:raise ValueError()\n            if any(not isinstance(args[k],str) or not args[k].endswith(\'+09:00\') for k in (\'since_kst\',\'until_kst\')):raise ValueError()\n            start,end=(parse_instant(args[k]) for k in (\'since_kst\',\'until_kst\'))\n            if not start or not end or not 0<(end-start).total_seconds()<=86400:raise ValueError()\n        return value\n    except (ValueError,TypeError,KeyError):\n        raise RuntimeError(\'sensor_read_requirements_invalid\') from None\n\n\ndef sensor_read_receipt(name, arguments, result):\n    if name not in (\'search_modsecurity_alerts\',\'search_suricata_alerts\') or not isinstance(arguments,dict):return None\n    if getattr(result,\'is_error\',getattr(result,\'isError\',False)):return None\n    for item in getattr(result,\'content\',[])[:20]:\n        raw=getattr(item,\'text\',None)\n        try:data=_unpack(json.loads(raw)) if isinstance(raw,str) else None\n        except (ValueError,TypeError):continue\n        source=name.removeprefix(\'search_\').removesuffix(\'_alerts\')\n        if (not isinstance(data,dict) or data.get(\'error\') or data.get(\'isError\') or\n                data.get(\'source_scope\')!=\'wazuh_indexed_alerts\' or data.get(\'source\')!=source):continue\n        start,end=(parse_instant(data.get(k)) for k in (\'requested_since_kst\',\'requested_until_kst\'))\n        if start and end and start<end and literal_ip(arguments.get(\'source_ip\')):\n            return {\'tool\':\'mcp__security_events__\'+name,\'source_ip\':arguments[\'source_ip\'],\n                    \'since\':start,\'until\':end}\n    return None\n\n\ndef missing_sensor_reads(requirements, receipts):\n    return [r for r in requirements if not any(c.get(\'tool\')==r[\'tool\'] and\n        c.get(\'source_ip\')==r[\'arguments\'][\'source_ip\'] and\n        c[\'since\']<=parse_instant(r[\'arguments\'][\'since_kst\']) and\n        c[\'until\']>=parse_instant(r[\'arguments\'][\'until_kst\']) for c in receipts)]\n\n\ndef known_status_input_rejection(name, arguments, requirements):\n    """Do not reinterpret a bound operation ID as a rule-change proposal ID."""\n    if (os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\')!=\'verify\' or not isinstance(arguments,dict)\n            or not re.fullmatch(r\'mcp__rule_[ab]__(?:get_operation_status|get_rule_change_status)\',name or \'\')):\n        return None\n    references=[status_read_request(r) for r in requirements if r[\'proposal_id\'] in\n                (arguments.get(\'request_id\'),arguments.get(\'proposal_id\'))]\n    if references and not any(name==r[\'tool\'] and arguments==r[\'arguments\'] for r in references):\n        return {\'error\':\'known_status_reference_kind_mismatch\',\'stage\':\'before_mcp\',\n            \'executed\':False,\'mcp_executed\':False,\'bound_references\':references,\n            \'detail\':\'\xec\x9d\xb4\xeb\xaf\xb8 \xea\xb2\xb0\xec\x86\x8d\xeb\x90\x9c ID\xec\x9d\x98 \xec\x9e\x91\xec\x97\x85 \xec\xa2\x85\xeb\xa5\x98 \xeb\x98\x90\xeb\x8a\x94 \xeb\x8b\xb4\xeb\x8b\xb9 \xec\x84\x9c\xeb\xb2\x84\xec\x99\x80 \xeb\x8b\xa4\xeb\xa6\x85\xeb\x8b\x88\xeb\x8b\xa4. bound_references\xec\x9d\x98 \xec\xa0\x95\xed\x99\x95 \xeb\x8f\x84\xea\xb5\xac/\xec\x9d\xb8\xec\x9e\x90\xeb\xa5\xbc \xec\x84\xa0\xed\x83\x9d\xed\x95\x98\xec\x84\xb8\xec\x9a\x94. \'\n                     \'\xec\x9d\xb4 \xec\x95\x88\xeb\x82\xb4\xeb\x8a\x94 \xec\xa1\xb0\xed\x9a\x8c \xea\xb2\xb0\xea\xb3\xbc\xc2\xb7\xec\x8a\xb9\xec\x9d\xb8\xc2\xb7\xec\xa2\x85\xea\xb2\xb0 \xea\xb7\xbc\xea\xb1\xb0\xea\xb0\x80 \xec\x95\x84\xeb\x8b\x99\xeb\x8b\x88\xeb\x8b\xa4.\'}\n    return None\n\n\ndef review_status_ids(name):\n    """Exact authenticated references or literal operator IDs, never log strings.\n\n    None means incomplete/legacy context: retain the ordinary inquiry schema.\n    An empty list means the tool is registered but lacks a supplied identifier.\n    """\n    if not readonly_incident_review() or not re.fullmatch(\n            r\'mcp__rule_[ab]__(?:get_operation_status|get_rule_change_status)\',name or \'\'):return None\n    ctx=compact_controller_context()\n    scope=ctx[\'evidence_scope\'] if ctx else {}\n    if scope.get(\'status_references_complete\') is not True:return None\n    rows=scope.get(\'status_references\')\n    if not isinstance(rows,list):return None\n    try:refs=status_read_requirements(json.dumps(rows)) if rows else []\n    except RuntimeError:return None\n    known={r[\'proposal_id\'] for r in refs if status_read_request(r)[\'tool\']==name}\n    explicit=set(re.findall(r\'(?<![0-9A-Za-z])[0-9a-f]{32}(?![0-9A-Za-z])\',ctx[\'operator_reason\']))\n    wrong={r[\'proposal_id\'] for r in refs}-known\n    return sorted(known|(explicit-wrong))\n\n\ndef known_status_selection_schema(name, schema, requirements):\n    """Bind supplied references without removing registry capabilities."""\n    value=copy.deepcopy(schema)\n    if not re.fullmatch(r\'mcp__rule_[ab]__(?:get_operation_status|get_rule_change_status)\',name or \'\'):\n        return value\n    key=\'request_id\' if name.endswith(\'__get_operation_status\') else \'proposal_id\'\n    correct={r[\'proposal_id\'] for r in requirements if status_read_request(r)[\'tool\']==name}\n    wrong=sorted({r[\'proposal_id\'] for r in requirements}-correct)\n    props=value.get(\'properties\',{})\n    if wrong and isinstance(props.get(key),dict):\n        # Keep the original string type at the property root. Some grammar\n        # compilers otherwise turn an allOf-only scalar into an empty object.\n        prior=props[key].get(\'not\')\n        props[key][\'not\']={\'anyOf\':[prior,{\'enum\':wrong}]} if isinstance(prior,(dict,bool)) else {\'enum\':wrong}\n    supplied=review_status_ids(name)\n    if supplied is not None and isinstance(props.get(key),dict):\n        if isinstance(props[key].get(\'enum\'),list):supplied=sorted(set(supplied)&set(props[key][\'enum\']))\n        if not supplied:return None\n        props[key][\'enum\']=supplied\n    return value\n\n\ndef read_ledger_entry(name, arguments, result):\n    """A completed dispatch record; no health, absence, freshness or risk verdict."""\n    if not allowed(name,\'verify\') or not isinstance(arguments,dict):return None\n    try:\n        args=json.dumps(arguments,ensure_ascii=False,sort_keys=True,allow_nan=False)\n        raw=result if isinstance(result,str) else json.dumps(result,ensure_ascii=False,allow_nan=False)\n        if len(args.encode())>8192 or len(raw.encode())>MAX_EVENT_AUDIT_BYTES:return None\n        def unique(pairs):\n            out={}\n            for key,value in pairs:\n                if key in out:raise ValueError(\'duplicate\')\n                out[key]=value\n            return out\n        def decode(value):\n            return json.loads(value,object_pairs_hook=unique,\n                parse_constant=lambda x:(_ for _ in ()).throw(ValueError(\'nonfinite\')))\n        payload=decode(raw);failed=False\n        for _ in range(5):\n            if not isinstance(payload,dict):break\n            failed=failed or bool(payload.get(\'error\') or payload.get(\'isError\') or payload.get(\'is_error\'))\n            if set(payload)<={\'result\',\'isError\'} and isinstance(payload.get(\'result\'),str):payload=decode(payload[\'result\'])\n            else:break\n    except (ValueError,TypeError,RecursionError,UnicodeError):return None\n    return {\'tool\':name,\'arguments\':json.loads(args),\'result_sha256\':hashlib.sha256(raw.encode()).hexdigest(),\n        \'result_state\':\'error\' if failed else \'returned\', \'completed_at_kst\':datetime.now(KST).isoformat()}\n\n\ndef read_ledger_view(rows):\n    if not isinstance(rows,list) or len(rows)>128:return None\n    for row in rows:\n        if (not isinstance(row,dict) or set(row)!={\'tool\',\'arguments\',\'result_sha256\',\'result_state\',\'completed_at_kst\'}\n                or not allowed(row.get(\'tool\'),\'verify\') or not isinstance(row.get(\'arguments\'),dict)\n                or not isinstance(row.get(\'result_sha256\'),str) or not re.fullmatch(r\'[0-9a-f]{64}\',row[\'result_sha256\'])\n                or row.get(\'result_state\') not in (\'returned\',\'error\') or parse_instant(row.get(\'completed_at_kst\')) is None):return None\n    return {\'scope\':\'actual_completed_dispatches_only; returned is not healthy or complete evidence\',\n        \'rows\':copy.deepcopy(rows),\'count\':len(rows)}\n\n\ndef review_execution_view(agent, rows):\n    \'Expose native wrap-up and actual dispatch errors; never evidence or approval.\'\n    ledger=read_ledger_view(rows);failures={}\n    for i,row in enumerate(ledger[\'rows\'] if ledger else []):\n        key=(row[\'tool\'],json.dumps(row[\'arguments\'],sort_keys=True))\n        if row[\'result_state\']==\'error\':failures.setdefault(key,[]).append(i)\n        else:failures.pop(key,None)\n    return {\'native_wrapup_requested\':getattr(agent,\'_run_budget_wrapup_injected\',False) is True,\n        \'repeated_error_ledger_indexes\':[v for v in failures.values() if len(v)>1]}\n\n\n@functools.lru_cache(maxsize=1)\ndef diagnostic_contract():\n    path=Path(globals().get(\'__file__\',\'/opt/data/management-code/run.py\')).with_name(\'chat_contract.py\')\n    if not path.is_file():path=Path(\'/opt/data/plugins/groot-query-completion/chat_contract.py\')\n    spec=importlib.util.spec_from_file_location(\'_management_diagnostic_contract\',path)\n    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)\n    return module\n\n\ndef operator_diagnostic_options(request, receipts=()):\n    """Offer root-bound existing reads; a wire failure is an attempt, not health."""\n    chat=chat_read_context()\n    if chat:\n        plan=diagnostic_contract().service_history_plan(request,chat[\'request\'],chat[\'requested_at_kst\'])\n        return (diagnostic_contract().service_history_state(plan,receipts)[\'pending\']\n                +diagnostic_contract().service_current_refresh_reads(plan,receipts))\n    if not readonly_incident_review() or os.environ.get(\'CAPSTONE_OPERATOR_REVIEW\')!=\'1\':return []\n    context=compact_controller_context()\n    return diagnostic_contract().operator_diagnostic_options(request,context,receipts) if context else []\n\n\ndef chat_diagnostic_state(request, receipts=()):\n    chat=chat_read_context()\n    plan=diagnostic_contract().service_history_plan(request,chat[\'request\'],chat[\'requested_at_kst\']) if chat else None\n    return diagnostic_contract().service_history_state(plan,receipts)\n\n\ndef required_sensor_input_rejection(name, arguments, requirements, receipts):\n    """Enforce the advertised required read scope; never repair or dispatch it."""\n    if os.environ.get(\'CAPSTONE_MANAGEMENT_MODE\') != \'verify\':\n        return None\n    pending=[r for r in missing_sensor_reads(requirements,receipts) if r[\'tool\']==name]\n    if not pending or any(arguments==r[\'arguments\'] for r in pending):\n        return None\n    return {\'error\':\'required_sensor_scope_mismatch\',\'stage\':\'before_mcp\',\n            \'executed\':False,\'mcp_executed\':False,\'required_read\':pending[0],\n            \'detail\':\'\xed\x95\x84\xec\x88\x98 \xec\x9d\xbd\xea\xb8\xb0\xec\x9d\x98 \xec\xa0\x95\xed\x99\x95\xed\x95\x9c \xec\x9d\xb8\xec\x9e\x90\xec\x99\x80 \xeb\x8b\xa4\xeb\xa5\xb4\xeb\xaf\x80\xeb\xa1\x9c \xed\x98\xb8\xec\xb6\x9c\xed\x95\x98\xec\xa7\x80 \xec\x95\x8a\xec\x95\x98\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4. \'\n                     \'\xec\x86\x8c\xec\x88\x98\xec\xa0\x90 \xec\x8b\x9c\xea\xb0\x81\xc2\xb7\xec\xb6\x9c\xeb\xb0\x9c\xec\xa7\x80\xc2\xb7\xed\x91\x9c\xeb\xb3\xb8 \xec\x88\x98\xeb\xa5\xbc \xed\x8f\xac\xed\x95\xa8\xed\x95\x9c required_read.arguments\xeb\xa5\xbc \xea\xb7\xb8\xeb\x8c\x80\xeb\xa1\x9c \xec\x84\xa0\xed\x83\x9d\xed\x95\x98\xec\x84\xb8\xec\x9a\x94. \'\n                     \'\xec\x9d\xb4 \xec\xb0\xb8\xec\xa1\xb0\xeb\x8a\x94 \xec\xa1\xb0\xed\x9a\x8c \xec\x84\xb1\xea\xb3\xb5\xec\x9d\xb4\xeb\x82\x98 \xec\x9c\x84\xed\x97\x98 \xed\x8c\x90\xeb\x8b\xa8\xc2\xb7\xec\x8a\xb9\xec\x9d\xb8 \xec\xa7\x80\xec\x8b\x9c\xea\xb0\x80 \xec\x95\x84\xeb\x8b\x99\xeb\x8b\x88\xeb\x8b\xa4.\'}\n\n\ndef chat_read_schema(name, schema):\n    \'Project verified registry conditions into equivalent model grammar branches.\'\n    if name in {\'mcp__security_events__\'+n for n in\n            (\'search_suricata_alerts\',\'search_modsecurity_alerts\',\'search_wazuh_alerts\',\'search_web_access\')}:\n        if (schema.get(\'type\')!=\'object\' or schema.get(\'additionalProperties\') is not False\n                or schema.get(\'dependentRequired\')!={\'since_kst\':[\'until_kst\']}\n                or schema.get(\'allOf\')!=[{\'not\':{\'required\':[\'since_kst\',\'lookback_minutes\']}}]\n                or not {\'since_kst\',\'until_kst\',\'lookback_minutes\'}<=set(schema.get(\'properties\',{}))):\n            return schema\n        recent=copy.deepcopy(schema);past=copy.deepcopy(schema)\n        for value in (recent,past):\n            value.pop(\'allOf\');value.pop(\'dependentRequired\')\n        recent[\'properties\'].pop(\'since_kst\')\n        past[\'properties\'].pop(\'lookback_minutes\')\n        past[\'required\']=list(dict.fromkeys(past.get(\'required\',[])+[\'since_kst\',\'until_kst\']))\n        return {\'anyOf\':[recent,past]}\n    if name!=\'mcp__system_diagnostics__get_system_diagnostics\':return schema\n    rules=schema.get(\'allOf\',[])\n    expected=[{\'not\':{\'required\':[\'lookback_minutes\',\'since_kst\']}},\n              {\'not\':{\'required\':[\'lookback_minutes\',\'until_kst\']}}]\n    journal_conditions=[{\'if\':{\'required\':[\'view\']},\'then\':{\'required\':[\'since_kst\',\'until_kst\']}},\n                        {\'if\':{\'required\':[\'journal_scope\']},\'then\':{\'required\':[\'view\']}}]\n    journal=(len(rules)==5 and rules[2:4]==journal_conditions\n             and schema.get(\'properties\',{}).get(\'view\',{}).get(\'enum\')==[\'journal\']\n             and schema.get(\'properties\',{}).get(\'journal_scope\',{}).get(\'enum\')==[\'errors\',\'all\'])\n    if (not (len(rules)==3 or journal) or rules[:2]!=expected or rules[-1].get(\'if\')!={\'required\':[\'since_kst\']}\n            or schema.get(\'dependentRequired\')!={\'since_kst\':[\'until_kst\'],\'until_kst\':[\'since_kst\']}):return schema\n    if not journal and {\'view\',\'journal_scope\'} & set(schema.get(\'properties\',{})):return schema\n    condition=rules[-1].get(\'then\',{})\n    history=condition.get(\'properties\',{}).get(\'target\',{}).get