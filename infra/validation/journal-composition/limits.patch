+        self.assertEqual([x[0][-1] for x in calls],[d.SERVICE,d.BACKFILL_SERVICE])
+        self.assertTrue(all(x[0][:3]==['/usr/bin/systemctl','show','--no-pager'] and x[1]['timeout']==10 for x in calls))
+
