+"""Historical peer context boundaries, without a model, network or live state."""
+import concurrent.futures
+import copy
+import hashlib
+import json
+import unittest
+from unittest import mock
+
+import review_channel as controller
+import review_channel_policy as policy
+import review_channel_worker as worker
+import test_review_channel as fixtures
+
+
+def event_call(limit=15, error=False):
+    args={'lookback_minutes':45,'limit':limit,'program_name':'sshd'}
+    result={'source':'wazuh','requested_since_kst':'2026-11-14T09:00:00+09:00',
+        'requested_until_kst':'2026-11-14T09:45:00+09:00','lookback_minutes':45,
+        'limit':limit,'returned_count':limit,'scanned':limit,'scan_capped':True,
+        'applied_filters':{'program_name':'sshd'},'indexed_window_total_count':None,
+        'truncated':True,'alerts':[{'message':'PRIVATE_RAW_EVENT_BODY'}]}
+    raw=json.dumps(result,ensure_ascii=False)
+    return {'server':'security-events','name':'search_wazuh_alerts','arguments':args,
+        'result':raw,'result_sha256':hashlib.sha256(raw.encode()).hexdigest(),'is_error':error,'is_write':False}
+
+
+class HistoricalContext(unittest.TestCase):
+    def setUp(self):
+        self.fixture=fixtures.Tests();self.fixture.setUp()
+        self.h=self.fixture.actual_harness();self.d=self.fixture.d
+
+    def tearDown(self):self.fixture.tearDown()
+
+    def lead(self, engine='hermes', status='partial', ids=True):
+        self.fixture.post['message']='@'+engine+' Wazuh 경보 표본과 전체 건수를 구분해줘. 서로 검증해줘'
+        self.d.add(self.fixture.post);lead=self.fixture.job()
+        self.question=self.d.db.execute('SELECT current_question FROM request_context WHERE source_id=?',(lead['source_id'],)).fetchone()[0]
+        call=event_call()
+        report={'status':status,'final_response':'표본15건이며 전체 건수는 확인하지 못했습니다.',
+            'protected_calls':0,'calls':[call]}
+        if ids:report.update(run_id='1'*32,case_id='2'*32)
+        audit=json.loads(controller.private_read_audit(dict(report,status='partial'),self.h.EVIDENCE.allowed))
+        audit['status']=status
+        self.store(lead,report,audit)
+        return self.fixture.job(),report,audit
+
+    def store(self,lead,report,audit,*,audit_sha=None):
+        summary={k:v for k,v in report.items() if k!='calls'}
+        summary['calls']=[{k:c[k] for k in ('server','name','is_error','is_write','result_sha256') if k in c} for c in report.get('calls',[])]
+        raw=json.dumps(audit,ensure_ascii=False)
+        with self.d.db:
+            self.d.db.execute('UPDATE jobs SET result=?,status=? WHERE id=?',(json.dumps(summary,ensure_ascii=False),'done',lead['id']))
+            self.d.db.execute('INSERT OR REPLACE INTO request_audits VALUES(?,?,?)',
+                (lead['id'],raw,audit_sha or hashlib.sha256(raw.encode()).hexdigest()))
+
+    def test_original_scope_fields_survive_beyond_the_old_1000_character_cap(self):
+        calls=[event_call(i+10) for i in range(8)]
+        source=worker.peer_source_answer(policy.peer_question('Wazuh 경보',{'final_response':'제한 표본'}, {'calls':calls}))
+        self.assertEqual(len(source['other_read_context']),8)
+        self.assertGreater(len(json.dumps(source['other_read_context'])),1000)
+        for original,row in zip(calls,source['other_read_context']):
+            value=json.loads(original['result'])
+            self.assertEqual(row['arguments'],original['arguments'])
+            for key in ('returned_count','scanned','scan_capped','applied_filters','indexed_window_total_count',
+                        'requested_since_kst','requested_until_kst','limit','truncated'):
+                self.assertEqual(row[key],value[key])
+        self.assertFalse(source['other_read_context_reusable'])
+        self.assertNotIn('PRIVATE_RAW_EVENT_BODY',json.dumps(source))
+        self.assertNotIn('other_read_context_omitted',source)
+
+    def test_native_partial_completion_reaches_peer_but_not_reusable_cache(self):
+        self.fixture.post['message']='@hermes Wazuh 경보 표본 보여줘. 서로 검증해줘'
+        self.d.add(self.fixture.post);lead=self.fixture.job();self.d.placeholder(lead)
+        call=event_call();audit=worker.native_read_audit([call],self.h.EVIDENCE.allowed,'1'*32,'2'*32)
+        report={'status':'partial','final_response':'조회 표본15건, 전체는 미확인입니다.',
+            'run_id':'1'*32,'case_id':'2'*32,'protected_calls':0,
+            'calls':[{'name':call['name'],'is_error':False,'is_write':False}],'native_read_audit':audit}
+        future=concurrent.futures.Future();future.set_result(report)
+        self.d.active['hermes']=(future,lead['id']);pool=mock.Mock();self.d.tick(pool)
+        peer=self.fixture.job('peer');source=worker.peer_source_answer(peer['question'])
+        self.assertEqual(source['other_read_context_origin'],'source_read_audit')
+        self.assertEqual(source['other_read_context'][0]['returned_count'],15)
+        self.assertEqual(source['other_read_context'][0]['arguments']['limit'],15)
+        self.assertTrue(pool.submit.call_args.args[1]['readonly'])
+        self.assertEqual(self.d.db.execute('SELECT count(*) FROM request_evidence').fetchone()[0],0)
+        self.assertNotIn('PRIVATE_RAW_EVENT_BODY',peer['question'])
+        self.assertNotIn('PRIVATE_RAW_EVENT_BODY',json.dumps(self.fixture.apis['hermes'].sent))
+
+    def test_audit_envelope_is_bound_to_request_run_case_status_and_hash(self):
+        lead,report,audit=self.lead()
+        for field,value in (('run_id','3'*32),('case_id','4'*32),('status','completed'),
+                            ('schema',2),('schema',True),('reusable_evidence',True)):
+            with self.subTest(field=field):
+                bad=copy.deepcopy(audit);bad[field]=value;self.store(lead,report,bad)
+                self.assertIsNone(self.d.review_source_evidence(self.fixture.job(),self.question))
+        self.store(lead,report,audit,audit_sha='0'*64)
+        self.assertIsNone(self.d.review_source_evidence(self.fixture.job(),self.question))
+        self.store(lead,report,audit)
+        self.assertIsNone(self.d.review_source_evidence(self.fixture.job(),'다른 FW 요청'))
+        wrong=self.fixture.job();wrong['id']='5'*32
+        self.assertIsNone(self.d.review_source_evidence(wrong,self.question))
+        self.assertIsNotNone(self.d.review_source_evidence(self.fixture.job(),self.question))
+
+    def test_protected_reports_never_supply_audit_context(self):
+        lead,report,audit=self.lead()
+        for value in (dict(report,protected_calls=1),dict(report,calls=[dict(event_call(),is_write=True)])):
+            self.store(lead,value,audit)
+            self.assertIsNone(self.d.review_source_evidence(self.fixture.job(),self.question))
+
+    def test_bad_or_unavailable_receipts_are_explicit_not_zero_or_reused(self):
+        lead,report,audit=self.lead()
+        for kind in ('hash','tool','body','arguments','nan','argument_hash'):
+            with self.subTest(kind=kind):
+                bad=copy.deepcopy(audit);row=copy.deepcopy(bad['calls'][0]);bad['calls'].append(row)
+                if kind=='hash':row['result_sha256']='0'*64
+                if kind=='tool':row.update(server='resp',name='block_ip')
+                if kind=='body':row.pop('result');row['result_omitted']='aggregate_size_limit'
+                if kind=='arguments':row.pop('arguments')
+                if kind=='nan':row['arguments']['limit']=float('nan')
+                if kind=='argument_hash':row['arguments']['limit']=17
+                self.store(lead,report,bad)
+                evidence=self.d.review_source_evidence(self.fixture.job(),self.question)
+                self.assertEqual(len(evidence['calls']),1)
+                self.assertEqual(evidence['source_receipts_not_available'],1)
+                source=worker.peer_source_answer(policy.peer_question(self.question,report,evidence))
+                self.assertEqual(source['other_read_context_not_available_calls'],1)
+                self.assertEqual(source['other_read_context'][0]['returned_count'],15)
+
+    def test_successful_complete_cache_precedes_audit_and_partial_cache_is_ignored(self):
+        lead,report,audit=self.lead(status='completed')
+        cached={'question':self.question,'calls':[event_call(23)]}
+        with self.d.db:self.d.retain_evidence(lead['id'],json.dumps(cached,ensure_ascii=False))
+        evidence=self.d.review_source_evidence(self.fixture.job(),self.question)
+        self.assertEqual(evidence['origin'],'completed_read_receipt')
+        self.assertEqual(evidence['calls'][0]['arguments']['limit'],23)
+        report['status']=audit['status']='partial';self.store(lead,report,audit)
+        evidence=self.d.review_source_evidence(self.fixture.job(),self.question)
+        self.assertEqual(evidence['origin'],'source_read_audit')
+        self.assertEqual(evidence['calls'][0]['arguments']['limit'],15)
+
+    def test_idless_sdk_audit_uses_same_job_binding_and_native_requires_ids(self):
+        lead,report,audit=self.lead(engine='ollama',ids=False)
+        self.assertIsNotNone(self.d.review_source_evidence(self.fixture.job(),self.question))
+        report['run_id']='1'*32;self.store(lead,report,audit)
+        self.assertIsNone(self.d.review_source_evidence(self.fixture.job(),self.question))
+
+    def test_native_audit_without_run_and_case_cannot_bind(self):
+        lead,report,audit=self.lead(engine='hermes',ids=False)
+        self.assertIsNone(self.d.review_source_evidence(lead,self.question))
+
+    def test_failed_target_read_keeps_request_scope_without_inventing_result_target(self):
+        raw=json.dumps({'error':'read unavailable'})
+        call={'server':'system-diagnostics','name':'get_system_diagnostics','arguments':{'target':'b:hermes'},
+            'is_error':True,'result':raw,'result_sha256':hashlib.sha256(raw.encode()).hexdigest()}
+        source=worker.peer_source_answer(policy.peer_question('헤르메스 상태',{'final_response':'조회 실패'}, {'calls':[call]}))
+        row=source['other_read_context'][0]
+        self.assertTrue(row['is_error']);self.assertTrue(row['result_target_unconfirmed'])
+        self.assertEqual(row['arguments']['target'],'b:hermes');self.assertNotIn('target',row)
+        self.assertEqual(source['other_diagnostic_receipts'],[])
+
+    def test_rules_and_service_scope_metadata_share_the_same_projection(self):
+        for name,fields in (('get_security_rules',{'counts':{'builtin':120,'custom':4},'offset':10,'next_offset':20,'snapshot_id':'snap'}),
+                            ('get_firewall_rules',{'counts':{'tables':2,'rules':60},'truncated':False}),
+                            ('get_host_inventory',{'total_count':6,'page_size':3,'has_more':True})):
+            call=event_call();call['name']=name
+            call['result']=json.dumps(fields);call['result_sha256']=hashlib.sha256(call['result'].encode()).hexdigest()
+            source=worker.peer_source_answer(policy.peer_question('조회 결과 검토',{'final_response':'표본'}, {'calls':[call]}))
+            self.assertEqual({k:source['other_read_context'][0][k] for k in fields},fields)
+
+    def test_failed_read_metadata_is_historical_and_never_current_proof(self):
+        call=event_call(error=True)
+        source=worker.peer_source_answer(policy.peer_question('Wazuh 경보',{'final_response':'당시 읽기 실패'}, {'calls':[call]}))
+        self.assertTrue(source['other_read_context'][0]['is_error'])
+        fresh=event_call(31);catalog=worker.peer_reference_catalog(source,[fresh])
+        raw=worker.compact_peer_result(fresh['result'])
+        self.assertTrue(all(row['quote'] in raw and row['call_index']==0 for row in catalog['evidence']))
+        self.assertNotIn(call['result_sha256'],json.dumps(catalog['evidence']))
+
+    def test_context_and_full_packet_bounds_keep_valid_json_and_truncation_labels(self):
+        raw=json.dumps({'target':'b:hermes','padding':'가'*4000},ensure_ascii=False)
+        call={'server':'system-diagnostics','name':'get_system_diagnostics','arguments':{'target':'b:hermes','oversized':'x'*5000},
+              'result':raw,'result_sha256':hashlib.sha256(raw.encode()).hexdigest()}
+        question='가'*6000
+        packet=policy.peer_question(question,{'final_response':'나"\\'*8000},{'calls':[call]*8})
