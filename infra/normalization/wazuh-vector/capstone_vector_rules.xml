<!-- Vector shadow correlation. The ready lane remains no_log. Operational
     health rules and a separate root-only synthetic canary can emit alerts.
     Wazuh timeframe is processing time, not source event time. -->
<group name="capstone_vector,package_shadow,">
  <rule id="100200" level="1">
    <decoded_as>json</decoded_as>
    <location type="pcre2">^\(groot-sec\) any->/var/log/capstone-vector/ready/normalized\.jsonl$</location>
    <field name="capstone_norm.schema_version" type="pcre2">^vector-1$</field>
    <field name="capstone_norm.pipeline" type="pcre2">^vector$</field>
    <field name="capstone_norm.source" type="pcre2">^(suricata|nftables|modsecurity)$</field>
    <description>Capstone Vector normalized shadow input</description>
    <options>no_log</options>
  </rule>
  <rule id="100201" level="1">
    <if_sid>100200</if_sid>
    <location type="pcre2">^\(groot-sec\) any->/var/log/capstone-vector/ready/normalized\.jsonl$</location>
    <field name="capstone_norm.correlation_eligible" type="pcre2">^true$</field>
    <field name="capstone_norm.correlation_time_class" type="pcre2">^fresh$</field>
    <field name="capstone_norm.protected_asset" type="pcre2">^false$</field>
    <field name="capstone_norm.correlation_key" type="pcre2">^[0-9a-f]{64}$</field>
    <field name="capstone_norm.correlation_dedupe_key" type="pcre2">^[0-9a-f]{64}$</field>
    <field name="capstone_norm.sensor" type="pcre2">^groot-sec$</field>
    <field name="capstone_norm.protocol" type="pcre2">^(tcp|udp)$</field>
    <description>Fresh normalized service-direction observation; shadow only</description>
    <options>no_log</options>
  </rule>
  <rule id="100210" level="1">
    <if_sid>100201</if_sid>
    <field name="capstone_norm.source" type="pcre2">^suricata$</field>
    <field name="capstone_norm.action" type="pcre2">^(allowed|observed|blocked)$</field>
    <description>Eligible suricata service observation; shadow only</description>
    <options>no_log</options>
  </rule>
  <rule id="100211" level="1">
    <if_sid>100201</if_sid>
    <field name="capstone_norm.source" type="pcre2">^nftables$</field>
    <field name="capstone_norm.action" type="pcre2">^logged_drop$</field>
    <description>Eligible nftables service observation; shadow only</description>
    <options>no_log</options>
  </rule>
  <rule id="100220" level="2" frequency="5" timeframe="60">
    <if_sid>100210</if_sid>
    <if_matched_sid>100210</if_matched_sid>
    <same_field>capstone_norm.sensor</same_field>
    <same_field>capstone_norm.correlation_key</same_field>
    <different_field>capstone_norm.correlation_dedupe_key</different_field>
    <description>Shadow: repeated Suricata observations on the same service direction (processing-time window)</description>
    <options>no_log</options>
  </rule>
  <rule id="100221" level="2" frequency="5" timeframe="60">
    <if_sid>100211</if_sid>
    <if_matched_sid>100211</if_matched_sid>
    <same_field>capstone_norm.sensor</same_field>
    <same_field>capstone_norm.correlation_key</same_field>
    <different_field>capstone_norm.correlation_dedupe_key</different_field>
    <description>Shadow: repeated nftables observations on the same service direction (processing-time window)</description>
    <options>no_log</options>
  </rule>
  <rule id="100230" level="2" frequency="2" timeframe="60">
    <if_sid>100211</if_sid>
    <if_matched_sid>100210</if_matched_sid>
    <same_field>capstone_norm.sensor</same_field>
    <same_field>capstone_norm.correlation_key</same_field>
    <description>Shadow: Suricata then nftables on the same service direction (processing-time window)</description>
    <options>no_log</options>
  </rule>
  <rule id="100231" level="2" frequency="2" timeframe="60">
    <if_sid>100210</if_sid>
    <if_matched_sid>100211</if_matched_sid>
    <same_field>capstone_norm.sensor</same_field>
    <same_field>capstone_norm.correlation_key</same_field>
    <description>Shadow: nftables then Suricata on the same service direction (processing-time window)</description>
    <options>no_log</options>
  </rule>
